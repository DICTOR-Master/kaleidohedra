lemma tiT_spec : ∀ k, (tiT k).1 ≠ (tiT k).2.1 ∧ (tiT k).1 ≠ (tiT k).2.2 ∧
    (tiT k).2.1 ≠ (tiT k).2.2 ∧ tiZ (tiT k).1 k = true ∧ tiZ (tiT k).2.1 k = true ∧
    tiZ (tiT k).2.2 k = true := by decide

lemma tiE_lt : ∀ e, tiFi e < tiFj e := by decide

lemma tiE_inj : ∀ e e', tiFi e = tiFi e' → tiFj e = tiFj e' → e = e' := by decide

lemma tiE_tight : ∀ e, tiZ (tiFi e) (tiVk e) = true ∧ tiZ (tiFi e) (tiVl e) = true ∧
    tiZ (tiFj e) (tiVk e) = true ∧ tiZ (tiFj e) (tiVl e) = true := by decide

lemma tiE_other : ∀ e m, m ≠ tiFi e → m ≠ tiFj e →
    tiZ m (tiVk e) = false ∨ tiZ m (tiVl e) = false := by decide

/-- The statement of `IsEdgeData.cover`. -/
def tiCover (x : R3) (i j : Fin 32) : Prop :=
  (∃ e, ({i, j} : Set (Fin 32)) = {tiFi e, tiFj e} ∧
    x ∈ segment ℝ (tiP (tiVk e)) (tiP (tiVl e))) ∨ ∃ k, x = tiP k

