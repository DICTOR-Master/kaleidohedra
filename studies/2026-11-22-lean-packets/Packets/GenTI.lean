lemma ti_tight (m : Fin 32) (k : Fin 60) (h : tiZ m k = true) : ⟪tiN m, tiP k⟫ = tiB m := by
  have h1 := ti_slack m k
  have h2 := (tiS_spec m k).1 h
  linarith

lemma ti_lt (m : Fin 32) (k : Fin 60) (h : tiZ m k = false) : ⟪tiN m, tiP k⟫ < tiB m := by
  have h1 := ti_slack m k
  have h2 := (tiS_spec m k).2 h
  linarith

lemma ti_le (m : Fin 32) (k : Fin 60) : ⟪tiN m, tiP k⟫ ≤ tiB m := by
  cases h : tiZ m k
  · exact (ti_lt m k h).le
  · exact (ti_tight m k h).le

