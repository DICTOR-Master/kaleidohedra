/-- The 30 edges: the two faces of each edge … -/
def ihFi : Fin 30 → Fin 20 := ![0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5, 5, 5, 6, 6, 6, 7, 7, 7, 8, 10, 12, 13, 16, 18]
def ihFj : Fin 30 → Fin 20 := ![8, 12, 16, 9, 13, 16, 10, 12, 17, 11, 13, 17, 8, 14, 18, 9, 15, 18, 10, 14, 19, 11, 15, 19, 9, 11, 14, 15, 17, 19]
/-- … and its two corners. -/
def ihVk : Fin 30 → Fin 12 := ![0, 0, 4, 1, 1, 5, 2, 2, 4, 3, 3, 5, 0, 0, 6, 1, 1, 7, 2, 2, 6, 3, 3, 7, 8, 9, 0, 1, 4, 6]
def ihVl : Fin 30 → Fin 12 := ![8, 4, 8, 8, 5, 8, 9, 4, 9, 9, 5, 9, 10, 6, 10, 10, 7, 10, 11, 6, 11, 11, 7, 11, 10, 11, 2, 3, 5, 7]

/-- Three faces through each corner. -/
def ihT : Fin 12 → Fin 20 × Fin 20 × Fin 20 :=
  ![(0, 4, 8), (1, 5, 9), (2, 6, 10), (3, 7, 11), (0, 2, 12), (1, 3, 13), (4, 6, 14), (5, 7, 15), (0, 1, 8), (2, 3, 10), (4, 5, 8), (6, 7, 10)]

lemma ihT_spec : ∀ k, (ihT k).1 ≠ (ihT k).2.1 ∧ (ihT k).1 ≠ (ihT k).2.2 ∧
    (ihT k).2.1 ≠ (ihT k).2.2 ∧ ihZ (ihT k).1 k = true ∧ ihZ (ihT k).2.1 k = true ∧
    ihZ (ihT k).2.2 k = true := by decide

lemma ihE_lt : ∀ e, ihFi e < ihFj e := by decide

lemma ihE_inj : ∀ e e', ihFi e = ihFi e' → ihFj e = ihFj e' → e = e' := by decide

lemma ihE_tight : ∀ e, ihZ (ihFi e) (ihVk e) = true ∧ ihZ (ihFi e) (ihVl e) = true ∧
    ihZ (ihFj e) (ihVk e) = true ∧ ihZ (ihFj e) (ihVl e) = true := by decide

lemma ihE_other : ∀ e m, m ≠ ihFi e → m ≠ ihFj e →
    ihZ m (ihVk e) = false ∨ ihZ m (ihVl e) = false := by decide

/-- The statement of `IsEdgeData.cover`. -/
def ihCover (x : R3) (i j : Fin 20) : Prop :=
  (∃ e, ({i, j} : Set (Fin 20)) = {ihFi e, ihFj e} ∧
    x ∈ segment ℝ (ihP (ihVk e)) (ihP (ihVl e))) ∨ ∃ k, x = ihP k

