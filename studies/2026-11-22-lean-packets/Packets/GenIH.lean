    (1 + √5) * x 0 + (-1 + √5) * x 1 + 0 * x 2 ≤ (6 + 2 * √5) ∧
    (1 + √5) * x 0 + (1 - √5) * x 1 + 0 * x 2 ≤ (6 + 2 * √5) ∧
    (-1 - √5) * x 0 + (-1 + √5) * x 1 + 0 * x 2 ≤ (6 + 2 * √5) ∧
    (-1 - √5) * x 0 + (1 - √5) * x 1 + 0 * x 2 ≤ (6 + 2 * √5) :=
  ⟨by have h := hx 0; simp [ihN, ihB, inner3] at h; linarith,
   by have h := hx 1; simp [ihN, ihB, inner3] at h; linarith,
   by have h := hx 2; simp [ihN, ihB, inner3] at h; linarith,
   by have h := hx 3; simp [ihN, ihB, inner3] at h; linarith,
