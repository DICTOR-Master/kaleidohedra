def tdVl : Fin 90 → Fin 60 := ![6, 44, 48, 36, 40, 44, 48, 16, 20, 24, 7, 45, 49, 37, 41, 45, 49, 17, 21, 25, 46, 50, 38, 42, 46, 50, 18, 22, 26, 47, 51, 39, 43, 47, 51, 19, 23, 27, 9, 52, 54, 52, 54, 22, 28, 30, 53, 55, 53, 55, 23, 29, 31, 11, 56, 58, 56, 58, 26, 32, 34, 57, 59, 57, 59, 27, 33, 35, 1, 52, 53, 12, 13, 29, 3, 54, 55, 14, 15, 31, 56, 57, 16, 17, 33, 58, 59, 18, 19, 35]

