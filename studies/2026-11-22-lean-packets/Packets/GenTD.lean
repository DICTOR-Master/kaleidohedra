lemma td_tight (m : Fin 32) (k : Fin 60) (h : tdZ m k = true) : ⟪tdN m, tdP k⟫ = tdB m := by
  have h1 := td_slack m k
  have h2 := (tdS_spec m k).1 h
  linarith

lemma td_lt (m : Fin 32) (k : Fin 60) (h : tdZ m k = false) : ⟪tdN m, tdP k⟫ < tdB m := by
  have h1 := td_slack m k
  have h2 := (tdS_spec m k).2 h
  linarith

lemma td_le (m : Fin 32) (k : Fin 60) : ⟪tdN m, tdP k⟫ ≤ tdB m := by
  cases h : tdZ m k
  · exact (td_lt m k h).le
  · exact (td_tight m k h).le

/-- The face inequalities in coordinates. -/
lemma td_ineqs {x : R3} (hx : x ∈ sol tdN tdB) :
    0 * x 0 + 2 * x 1 + (1 + √5) * x 2 ≤ (10 + 6 * √5) ∧
    0 * x 0 + 2 * x 1 + (-1 - √5) * x 2 ≤ (10 + 6 * √5) ∧
    0 * x 0 + (-2) * x 1 + (1 + √5) * x 2 ≤ (10 + 6 * √5) ∧
    0 * x 0 + (-2) * x 1 + (-1 - √5) * x 2 ≤ (10 + 6 * √5) ∧
    (1 + √5) * x 0 + 0 * x 1 + 2 * x 2 ≤ (10 + 6 * √5) ∧
    (1 + √5) * x 0 + 0 * x 1 + (-2) * x 2 ≤ (10 + 6 * √5) ∧
    (-1 - √5) * x 0 + 0 * x 1 + 2 * x 2 ≤ (10 + 6 * √5) ∧
    (-1 - √5) * x 0 + 0 * x 1 + (-2) * x 2 ≤ (10 + 6 * √5) ∧
    2 * x 0 + (1 + √5) * x 1 + 0 * x 2 ≤ (10 + 6 * √5) ∧
    2 * x 0 + (-1 - √5) * x 1 + 0 * x 2 ≤ (10 + 6 * √5) ∧
    (-2) * x 0 + (1 + √5) * x 1 + 0 * x 2 ≤ (10 + 6 * √5) ∧
    (-2) * x 0 + (-1 - √5) * x 1 + 0 * x 2 ≤ (10 + 6 * √5) ∧
    2 * x 0 + 2 * x 1 + 2 * x 2 ≤ (16 + 4 * √5) ∧
    2 * x 0 + 2 * x 1 + (-2) * x 2 ≤ (16 + 4 * √5) ∧
    2 * x 0 + (-2) * x 1 + 2 * x 2 ≤ (16 + 4 * √5) ∧
    2 * x 0 + (-2) * x 1 + (-2) * x 2 ≤ (16 + 4 * √5) ∧
    (-2) * x 0 + 2 * x 1 + 2 * x 2 ≤ (16 + 4 * √5) ∧
    (-2) * x 0 + 2 * x 1 + (-2) * x 2 ≤ (16 + 4 * √5) ∧
