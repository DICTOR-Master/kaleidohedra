lemma tdT_spec : ∀ k, (tdT k).1 ≠ (tdT k).2.1 ∧ (tdT k).1 ≠ (tdT k).2.2 ∧
    (tdT k).2.1 ≠ (tdT k).2.2 ∧ tdZ (tdT k).1 k = true ∧ tdZ (tdT k).2.1 k = true ∧
    tdZ (tdT k).2.2 k = true := by decide

lemma tdE_lt : ∀ e, tdFi e < tdFj e := by decide

lemma tdE_inj : ∀ e e', tdFi e = tdFi e' → tdFj e = tdFj e' → e = e' := by decide

lemma tdE_tight : ∀ e, tdZ (tdFi e) (tdVk e) = true ∧ tdZ (tdFi e) (tdVl e) = true ∧
    tdZ (tdFj e) (tdVk e) = true ∧ tdZ (tdFj e) (tdVl e) = true := by decide

lemma tdE_other : ∀ e m, m ≠ tdFi e → m ≠ tdFj e →
    tdZ m (tdVk e) = false ∨ tdZ m (tdVl e) = false := by decide

/-- The statement of `IsEdgeData.cover`. -/
def tdCover (x : R3) (i j : Fin 32) : Prop :=
  (∃ e, ({i, j} : Set (Fin 32)) = {tdFi e, tdFj e} ∧
    x ∈ segment ℝ (tdP (tdVk e)) (tdP (tdVl e))) ∨ ∃ k, x = tdP k

