lemma co_cover_0_1 {t : ℝ} {x : R3} (_ht1 : 1 < t) (_ht2 : t < 2) (hx : x ∈ sol coN (coB t)) (hi : ⟪coN 0, x⟫ = coB t 0)
    (hj : ⟪coN 1, x⟫ = coB t 1) : coCover t x 0 1 := by
  have H := co_ineqs hx
  simp [coN, coB, inner3] at hi hj
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13⟩ := H
  exfalso; linarith

