    !₂[(1 - t), 1, 0],
    !₂[0, 1, (t - 1)],
    !₂[0, 1, (1 - t)],
    !₂[(t - 1), (-1), 0],
    !₂[(1 - t), (-1), 0],
    !₂[0, (-1), (t - 1)],
    !₂[0, (-1), (1 - t)],
    !₂[(t - 1), 0, 1],
    !₂[(1 - t), 0, 1],
    !₂[0, (t - 1), 1],
    !₂[0, (1 - t), 1],
    !₂[(t - 1), 0, (-1)],
    !₂[(1 - t), 0, (-1)],
    !₂[0, (t - 1), (-1)],
    !₂[0, (1 - t), (-1)]]

