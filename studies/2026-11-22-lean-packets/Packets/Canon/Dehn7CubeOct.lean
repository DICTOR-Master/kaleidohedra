/-- Outward face normals. -/
noncomputable def coN : Fin 14 → R3 :=
  ![!₂[1, 0, 0],
    !₂[(-1), 0, 0],
    !₂[0, 1, 0],
    !₂[0, (-1), 0],
    !₂[0, 0, 1],
    !₂[0, 0, (-1)],
    !₂[1, 1, 1],
    !₂[1, 1, (-1)],
    !₂[1, (-1), 1],
    !₂[1, (-1), (-1)],
    !₂[(-1), 1, 1],
    !₂[(-1), 1, (-1)],
    !₂[(-1), (-1), 1],
    !₂[(-1), (-1), (-1)]]

/-- Offsets. -/
noncomputable def coB (t : ℝ) : Fin 14 → ℝ := ![1, 1, 1, 1, 1, 1, t, t, t, t, t, t, t, t]

/-- Corners. -/
noncomputable def coP (t : ℝ) : Fin 24 → R3 :=
  ![!₂[1, (t - 1), 0],
    !₂[1, (1 - t), 0],
    !₂[1, 0, (t - 1)],
    !₂[1, 0, (1 - t)],
    !₂[(-1), (t - 1), 0],
    !₂[(-1), (1 - t), 0],
    !₂[(-1), 0, (t - 1)],
    !₂[(-1), 0, (1 - t)],
