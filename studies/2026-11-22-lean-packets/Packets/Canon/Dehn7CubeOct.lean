lemma co_cover {t : ℝ} {x : R3} (ht1 : 1 < t) (ht2 : t < 2) (hx : x ∈ sol coN (coB t)) (i j : Fin 14) (hij : i ≠ j)
    (hi : ⟪coN i, x⟫ = coB t i) (hj : ⟪coN j, x⟫ = coB t j) : coCover t x i j := by
  rcases lt_or_gt_of_ne hij with h | h
  · exact co_cover_lt ht1 ht2 hx i j h hi hj
  · rcases co_cover_lt ht1 ht2 hx j i h hj hi with ⟨e, he, hseg⟩ | hk
    · exact Or.inl ⟨e, (Set.pair_comm i j).trans he, hseg⟩
    · exact Or.inr hk

/-- **The cube ∩ octahedron solids** |x_i| ≤ 1, |x| + |y| + |z| ≤ t. -/
def coSet (t : ℝ) : Set R3 := sol coN (coB t)

theorem co_bounded (t : ℝ) : Bornology.IsBounded (sol coN (coB t)) := by
  refine bounded_of_coords 1 (fun x hx i => ?_)
  obtain ⟨h0, h1, h2, h3, h4, h5, -⟩ := co_ineqs hx
  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] <;> rw [abs_le] <;>
    constructor <;> linarith

theorem isPoly_co (t : ℝ) : IsPoly (coSet t) := ⟨co_bounded t, Fin 14, inferInstance, coN, _, rfl⟩

/-- **For 1 < t < 2 the corners, faces and edges satisfy `IsEdgeData`.** -/
theorem co_isEdgeData {t : ℝ} (ht1 : 1 < t) (ht2 : t < 2) :
    IsEdgeData coN (coB t) (coP t) coFi coFj coVk coVl where
  bounded := co_bounded t
  corner_mem := fun k m => co_le t ht1 ht2 m k
  corner_three := fun k => by
    obtain ⟨h1, h2, h3, t1, t2, t3⟩ := coT_spec k
    exact ⟨_, _, _, h1, h2, h3, co_tight t ht1 ht2 _ _ t1, co_tight t ht1 ht2 _ _ t2,
      co_tight t ht1 ht2 _ _ t3⟩
  faces_ne := fun e => (coE_lt e).ne
  faces_inj := fun e e' h => by
    rcases Set.pair_eq_pair_iff.1 h with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact coE_inj e e' h1 h2
    · have a := coE_lt e
      rw [h1, h2] at a
      exact absurd a (lt_asymm (coE_lt e'))
  tight := fun e => by
    obtain ⟨t1, t2, t3, t4⟩ := coE_tight e
    exact ⟨co_tight t ht1 ht2 _ _ t1, co_tight t ht1 ht2 _ _ t2, co_tight t ht1 ht2 _ _ t3,
      co_tight t ht1 ht2 _ _ t4⟩
  other := fun e m h1 h2 => by
    rcases coE_other e m h1 h2 with h | h
    · exact Or.inl (co_lt t ht1 ht2 _ _ h)
    · exact Or.inr (co_lt t ht1 ht2 _ _ h)
  cover := fun x hx i j hij hi hj => co_cover ht1 ht2 hx i j hij hi hj

/-- Edges 0 to 23 (square–hexagon) have length √2 (t − 1) … -/
lemma co_dist_a {t : ℝ} (ht1 : 1 < t) (e : Fin 36) (he : e.val < 24) :
    dist (coP t (coVk e)) (coP t (coVl e)) = √2 * (t - 1) := by
  have h2 : (√2 : ℝ) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  apply dist3 _ _ (mul_nonneg (Real.sqrt_nonneg 2) (by linarith))
  rw [mul_pow, h2]
  fin_cases e <;> simp [coP, coVk, coVl] at he ⊢ <;> ring

/-- … edges 24 to 35 (hexagon–hexagon) have length √2 (2 − t). -/
lemma co_dist_b {t : ℝ} (ht2 : t < 2) (e : Fin 36) (he : 24 ≤ e.val) :
    dist (coP t (coVk e)) (coP t (coVl e)) = √2 * (2 - t) := by
  have h2 : (√2 : ℝ) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  apply dist3 _ _ (mul_nonneg (Real.sqrt_nonneg 2) (by linarith))
  rw [mul_pow, h2]
  fin_cases e <;> simp [coP, coVk, coVl] at he ⊢ <;> ring

/-- A square meets a hexagon at π − arccos(1/√3) … -/
lemma co_theta_a (e : Fin 36) (he : e.val < 24) :
    theta (cone coN ({coFi e, coFj e} : Set (Fin 14))) =
      (Submodule.Quotient.mk (π - octDelta) : Angle) := by
  have key : ∀ i j : Fin 14, ⟪coN i, coN i⟫ = 1 → ⟪coN j, coN j⟫ = 3 → ⟪coN i, coN j⟫ = -(-1) →
      theta (cone coN ({i, j} : Set (Fin 14))) = (Submodule.Quotient.mk (π - octDelta) : Angle) := by
    intro i j hii hjj hij
    rw [theta_pair_of_gram coN rfl (by norm_num) hii hjj hij (by norm_num), one_mul, arccos_neg_inv_sqrt3]
  fin_cases e <;> simp at he <;> apply key <;> simp [coN, coFi, coFj, inner3, norm3_sq] <;> norm_num

/-- … and two hexagons meet at π − arccos(1/3). -/
lemma co_theta_b (e : Fin 36) (he : 24 ≤ e.val) :
    theta (cone coN ({coFi e, coFj e} : Set (Fin 14))) =
      (Submodule.Quotient.mk (π - tetDihedral) : Angle) := by
  have key : ∀ i j : Fin 14, ⟪coN i, coN i⟫ = 3 → ⟪coN j, coN j⟫ = 3 → ⟪coN i, coN j⟫ = -(-1) →
      theta (cone coN ({i, j} : Set (Fin 14))) = (Submodule.Quotient.mk (π - tetDihedral) : Angle) := by
    intro i j hii hjj hij
    rw [theta_pair_of_gram coN rfl (by norm_num) hii hjj hij (by norm_num), Real.sqrt_mul_self (by norm_num),
      arccos_neg_third]
  fin_cases e <;> simp at he <;> apply key <;> simp [coN, coFi, coFj, inner3, norm3_sq] <;> norm_num

lemma co_term {t : ℝ} (ht1 : 1 < t) (ht2 : t < 2) (e : Fin 36) :
    dist (coP t (coVk e)) (coP t (coVl e)) ⊗ₜ[ℚ] theta (cone coN ({coFi e, coFj e} : Set (Fin 14))) =
      if e.val < 24 then edgeTerm (√2 * (t - 1)) (π - octDelta)
      else edgeTerm (√2 * (2 - t)) (π - tetDihedral) := by
  by_cases he : e.val < 24
  · rw [ite_eq_left he, co_dist_a ht1 e he, co_theta_a e he]; rfl
  · rw [ite_eq_right he, co_dist_b ht2 e (by omega), co_theta_b e (by omega)]; rfl

lemma co_card_a : (Finset.univ.filter fun e : Fin 36 => e.val < 24).card = 24 := by decide

lemma co_card_b : (Finset.univ.filter fun e : Fin 36 => ¬ e.val < 24).card = 12 := by decide

/-- **The Dehn invariant of the cube ∩ octahedron line**: 12√2 (2t − 3) ⊗ arccos(1/3), for 1 < t < 2. -/
theorem dehnSet_co {t : ℝ} (ht1 : 1 < t) (ht2 : t < 2) :
    dehnSet (coSet t) = edgeTerm (12 * √2 * (2 * t - 3)) tetDihedral := by
  unfold coSet
  rw [(co_isEdgeData ht1 ht2).dehnSet_eq, Finset.sum_congr rfl (fun e _ => co_term ht1 ht2 e),
    Finset.sum_ite, Finset.sum_const, Finset.sum_const, co_card_a, co_card_b, edgeTerm_pi_sub,
    edgeTerm_pi_sub]
  have hT : edgeTerm (√2 * (t - 1)) tetDihedral =
      -(edgeTerm (√2 * (t - 1)) octDelta + edgeTerm (√2 * (t - 1)) octDelta) := by
    rw [edgeTerm_octDelta_two, neg_neg]
  rw [show (12 * √2 * (2 * t - 3) : ℝ) = ((12 : ℤ) : ℝ) * (√2 * (t - 1)) + ((-12 : ℤ) : ℝ) * (√2 * (2 - t)) by
      push_cast; ring, edgeTerm_int, hT]
  abel

/-- **The truncated octahedron** is the member t = 3/2 (corners: the permutations of (±1, ±1/2, 0)). -/
def truncOctSet : Set R3 := coSet (3 / 2)

/-- **The truncated octahedron is a zero word.** -/
theorem dehnSet_truncOct : dehnSet truncOctSet = 0 := by
  unfold truncOctSet
  rw [dehnSet_co (by norm_num) (by norm_num), show (12 * √2 * (2 * (3 / 2 : ℝ) - 3)) = 0 by ring]
  unfold edgeTerm; rw [TensorProduct.zero_tmul]

/-- **Every other member of the cube ∩ octahedron line is a nonzero word.** -/
theorem dehnSet_co_ne_zero {t : ℝ} (ht1 : 1 < t) (ht2 : t < 2) (h : t ≠ 3 / 2) : dehnSet (coSet t) ≠ 0 := by
  rw [dehnSet_co ht1 ht2]
  refine edgeTerm_ne_zero ?_ tetDihedral_not_ratPi
  have : (2 * t - 3) ≠ 0 := fun h0 => h (by linarith)
  positivity

/-- **Lucky 7 is a nonzero word**: every member with 7/4 < t < 9/5 (the fair 14-face die is t = 1.7566…). -/
theorem dehnSet_luckySeven_ne_zero {t : ℝ} (h1 : 7 / 4 < t) (h2 : t < 9 / 5) : dehnSet (coSet t) ≠ 0 :=
  dehnSet_co_ne_zero (by linarith) (by linarith) (by intro h; rw [h] at h1; norm_num at h1)

end DehnCanon.Library
