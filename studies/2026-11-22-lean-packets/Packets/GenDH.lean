    ![.none, .none, .none, .none, .none, .none, .none, .none, .farkas (2, 0) (2, 0) 1 10 7 (-1, 1) (-1, 1) (0, 0), .farkas (2, 0) (2, 0) 3 11 7 (-1, 1) (-1, 1) (0, 0), .edge 26 6 1, .edge 27 6 3],
