/-- Outward face normals. -/
noncomputable def pyrDN : Fin 6 → R3 :=
  ![!₂[0, 2, (1 + √5)],
    !₂[4, (-2 + 2 * √5), (-2 - 2 * √5)],
    !₂[(2 + 2 * √5), (-4), (2 - 2 * √5)],
    !₂[(-4), (-2 + 2 * √5), (-2 - 2 * √5)],
    !₂[(-2 - 2 * √5), (-4), (2 - 2 * √5)],
    !₂[0, (-8), 0]]

/-- Offsets. -/
noncomputable def pyrDB : Fin 6 → ℝ := ![(6 + 2 * √5), 0, 0, 0, 0, 0]

/-- Corners. -/
noncomputable def pyrDP : Fin 6 → R3 :=
  ![!₂[0, 0, 0],
    !₂[2, 2, 2],
    !₂[(-2), 2, 2],
    !₂[0, (1 + √5), (-1 + √5)],
    !₂[(-1 + √5), 0, (1 + √5)],
    !₂[(1 - √5), 0, (1 + √5)]]

/-- The table "face `m` passes through corner `k`". -/
def pyrDZ : Fin 6 → Fin 6 → Bool :=
  ![![false, true, true, true, true, true],
    ![true, true, false, true, false, false],
    ![true, true, false, false, true, false],
    ![true, false, true, true, false, false],
    ![true, false, true, false, false, true],
    ![true, false, false, false, true, true]]

/-- The values `b m − ⟪n m, p k⟫`. -/
noncomputable def pyrDS : Fin 6 → Fin 6 → ℝ :=
  ![![(6 + 2 * √5), 0, 0, 0, 0, 0],
    ![0, 0, 16, 0, 16, (8 + 8 * √5)],
    ![0, 0, (8 + 8 * √5), 16, 0, 16],
    ![0, 16, 0, 0, (8 + 8 * √5), 16],
    ![0, (8 + 8 * √5), 0, 16, 16, 0],
    ![0, 16, 16, (8 + 8 * √5), 0, 0]]

lemma pyrD_slack_0 (k : Fin 6) : pyrDB 0 - ⟪pyrDN 0, pyrDP k⟫ = pyrDS 0 k := by
  have ht := sqrt5_sq
  fin_cases k <;> simp [pyrDB, pyrDN, pyrDP, pyrDS, inner3] <;> grind

