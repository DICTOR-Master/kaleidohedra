    (pyrD_tight 5 0 (by decide)) (μ := ((1 / 2) + (1 / 2) * √5)) (a := ((1 / 2) + (1 / 2) * √5)) (a' := 1) (by s5pos)
    (by have ht := sqrt5_sq; ext t; fin_cases t <;> simp [pyrDN] <;> grind) hx hi hj⟩

lemma pyrD_cover_4_5 {x : R3} (hx : x ∈ sol pyrDN pyrDB) (hi : ⟪pyrDN 4, x⟫ = pyrDB 4)
    (hj : ⟪pyrDN 5, x⟫ = pyrDB 5) : pyrDCover x 4 5 :=
