/-- The face inequalities in coordinates. -/
lemma pyrD_ineqs {x : R3} (hx : x ∈ sol pyrDN pyrDB) :
    0 * x 0 + 2 * x 1 + (1 + √5) * x 2 ≤ (6 + 2 * √5) ∧
    4 * x 0 + (-2 + 2 * √5) * x 1 + (-2 - 2 * √5) * x 2 ≤ 0 ∧
    (2 + 2 * √5) * x 0 + (-4) * x 1 + (2 - 2 * √5) * x 2 ≤ 0 ∧
    (-4) * x 0 + (-2 + 2 * √5) * x 1 + (-2 - 2 * √5) * x 2 ≤ 0 ∧
    (-2 - 2 * √5) * x 0 + (-4) * x 1 + (2 - 2 * √5) * x 2 ≤ 0 ∧
    0 * x 0 + (-8) * x 1 + 0 * x 2 ≤ 0 :=
  ⟨by have h := hx 0; simp [pyrDN, pyrDB, inner3] at h; linarith,
   by have h := hx 1; simp [pyrDN, pyrDB, inner3] at h; linarith,
