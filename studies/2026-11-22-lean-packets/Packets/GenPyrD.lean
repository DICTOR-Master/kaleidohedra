  Or.inr ⟨0, eq_of_tight pyrD_ind_2_4_1
    (pyrD_tight 1 0 (by decide)) (pyrD_tight 5 0 (by decide)) (pyrD_tight 2 0 (by decide))
    (pyrD_tight 4 0 (by decide)) (μ := ((1 / 2) + (1 / 2) * √5)) (a := ((1 / 2) + (1 / 2) * √5)) (a' := 1) (by s5pos)
    (by have ht := sqrt5_sq; ext t; fin_cases t <;> simp [pyrDN] <;> grind) hx hi hj⟩

lemma pyrD_cover_2_5 {x : R3} (hx : x ∈ sol pyrDN pyrDB) (hi : ⟪pyrDN 2, x⟫ = pyrDB 2)
    (hj : ⟪pyrDN 5, x⟫ = pyrDB 5) : pyrDCover x 2 5 :=
  Or.inl ⟨7, rfl, mem_segment_of_tight pyrD_ind_2_5_0
    (pyrD_tight 2 0 (by decide)) (pyrD_tight 2 4 (by decide))
    (pyrD_tight 5 0 (by decide)) (pyrD_tight 5 4 (by decide))
    (pyrD_tight 0 4 (by decide)) (pyrD_lt 0 0 (by decide))
    (pyrD_tight 1 0 (by decide)) (pyrD_lt 1 4 (by decide)) hx hi hj⟩

lemma pyrD_cover_3_4 {x : R3} (hx : x ∈ sol pyrDN pyrDB) (hi : ⟪pyrDN 3, x⟫ = pyrDB 3)
    (hj : ⟪pyrDN 4, x⟫ = pyrDB 4) : pyrDCover x 3 4 :=
  Or.inl ⟨8, rfl, mem_segment_of_tight pyrD_ind_3_4_0
    (pyrD_tight 3 0 (by decide)) (pyrD_tight 3 2 (by decide))
    (pyrD_tight 4 0 (by decide)) (pyrD_tight 4 2 (by decide))
    (pyrD_tight 0 2 (by decide)) (pyrD_lt 0 0 (by decide))
