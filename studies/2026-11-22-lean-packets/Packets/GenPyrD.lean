/-- The 10 edges: the two faces of each edge … -/
def pyrDFi : Fin 10 → Fin 6 := ![0, 0, 0, 0, 0, 1, 1, 2, 3, 4]
def pyrDFj : Fin 10 → Fin 6 := ![1, 2, 3, 4, 5, 2, 3, 5, 4, 5]
/-- … and its two corners. -/
def pyrDVk : Fin 10 → Fin 6 := ![1, 1, 2, 2, 4, 0, 0, 0, 0, 0]
def pyrDVl : Fin 10 → Fin 6 := ![3, 4, 3, 5, 5, 1, 3, 4, 2, 5]

/-- Three faces through each corner. -/
def pyrDT : Fin 6 → Fin 6 × Fin 6 × Fin 6 :=
  ![(1, 2, 3), (0, 1, 2), (0, 3, 4), (0, 1, 3), (0, 2, 5), (0, 4, 5)]

lemma pyrDT_spec : ∀ k, (pyrDT k).1 ≠ (pyrDT k).2.1 ∧ (pyrDT k).1 ≠ (pyrDT k).2.2 ∧
    (pyrDT k).2.1 ≠ (pyrDT k).2.2 ∧ pyrDZ (pyrDT k).1 k = true ∧ pyrDZ (pyrDT k).2.1 k = true ∧
    pyrDZ (pyrDT k).2.2 k = true := by decide

lemma pyrDE_lt : ∀ e, pyrDFi e < pyrDFj e := by decide

lemma pyrDE_inj : ∀ e e', pyrDFi e = pyrDFi e' → pyrDFj e = pyrDFj e' → e = e' := by decide

lemma pyrDE_tight : ∀ e, pyrDZ (pyrDFi e) (pyrDVk e) = true ∧ pyrDZ (pyrDFi e) (pyrDVl e) = true ∧
    pyrDZ (pyrDFj e) (pyrDVk e) = true ∧ pyrDZ (pyrDFj e) (pyrDVl e) = true := by decide

lemma pyrDE_other : ∀ e m, m ≠ pyrDFi e → m ≠ pyrDFj e →
    pyrDZ m (pyrDVk e) = false ∨ pyrDZ m (pyrDVl e) = false := by decide

/-- The statement of `IsEdgeData.cover`. -/
def pyrDCover (x : R3) (i j : Fin 6) : Prop :=
  (∃ e, ({i, j} : Set (Fin 6)) = {pyrDFi e, pyrDFj e} ∧
    x ∈ segment ℝ (pyrDP (pyrDVk e)) (pyrDP (pyrDVl e))) ∨ ∃ k, x = pyrDP k

