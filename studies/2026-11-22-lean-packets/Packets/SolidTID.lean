/-
Lean formalization of DICTO's paper #117 (Zenodo 10.5281/zenodo.24411660). Part 8b: the truncated icosidodecahedron,
Table 1 read from the set (generated by gen/mk_solids.py; edge data in GenTID1 … GenTIDn).
No `sorry`.
-/
module

public import Packets.Solids
public import Packets.GenTID

@[expose] public section

open Set Module
open scoped RealInnerProductSpace

set_option maxRecDepth 20000

namespace Packets

open DehnCanon.Library (sol R3 sqrt5_sq)
open PacketsGen

/-! ### The truncated icosidodecahedron -/

def tidSet : Set R3 := sol tidN tidB

lemma tid_ind (e : Fin 180) : LinearIndependent ℝ ![tidN (tidFi e), tidN (tidFj e)] :=
  linIndep_of_gram (tid_gram_lt e)

lemma tid_val (e : Fin 180) :
    Real.pi - InnerProductGeometry.angle (tidN (tidFi e)) (tidN (tidFj e)) = (![3 * Real.pi / 4 - α + β, Real.pi / 2 + α, Real.pi / 2 + α, 5 * Real.pi / 4 - β, 5 * Real.pi / 4 - β] : Fin 5 → ℝ) (tidKd e) := by
  obtain ⟨hg, hX, hY⟩ := tid_gram e
  rcases fin5_cases (tidKd e) with hk | hk | hk | hk | hk <;> rw [hk] at hg hX hY ⊢ <;>
    simp only [tidGg, tidGX, tidGY, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons] at hg hX hY ⊢
  · exact val_pentHex hg hX hY
  · exact val_decSqA hg hX hY
  · exact val_decSqB hg hX hY
  · exact val_hexSqA hg hX hY
  · exact val_hexSqB hg hX hY

/-- **The dihedral angles of the truncated icosidodecahedron, read from the set, are exactly its row of Table 1.** -/
theorem tid_edgeAngle (θ : ℝ) : EdgeAngle tidSet θ ↔ θ ∈ tid := by
  rw [tidSet, edgeAngle_edgeData tid_isEdgeData tid_interior tid_ind, tid_eq]
  constructor
  · rintro ⟨e, rfl⟩
    rw [tid_val]
    rcases fin5_cases (tidKd e) with hk | hk | hk | hk | hk <;> simp [hk]
  · intro h
    simp only [List.mem_cons, List.not_mem_nil, or_false] at h
    rcases h with rfl | rfl | rfl
    · exact ⟨120, by rw [tid_val]; rfl⟩
    · exact ⟨5, by rw [tid_val]; rfl⟩
    · exact ⟨0, by rw [tid_val]; rfl⟩

end Packets
