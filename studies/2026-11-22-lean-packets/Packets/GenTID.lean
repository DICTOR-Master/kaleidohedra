lemma tid_bd : ∀ t, tidSol.bOK (Solid.axis t) (tidBd t) = true := by decide +kernel

theorem tid_bounded : Bornology.IsBounded (sol tidN tidB) := by
  rw [tidN_eq, tidB_eq]; exact tidSol.bounded_of (by norm_num) tidBd tid_bd

theorem isPoly_tid : DehnCanon.Library.IsPoly tidSet := ⟨tid_bounded, Fin 62, inferInstance, tidN, _, rfl⟩

theorem tid_interior : (interior (sol tidN tidB)).Nonempty := by
  rw [tidN_eq, tidB_eq]; exact tidSol.interior_of (by norm_num) tidZc (1, 0) (by decide +kernel) (by decide +kernel)

lemma tid_mem : ∀ m k, tidSol.tight m k = true ∨ tidSol.below m k = true := by decide +kernel

lemma tid_three : ∀ k, (tidT k).1 ≠ (tidT k).2.1 ∧ (tidT k).1 ≠ (tidT k).2.2 ∧ (tidT k).2.1 ≠ (tidT k).2.2 ∧
    tidSol.tight (tidT k).1 k = true ∧ tidSol.tight (tidT k).2.1 k = true ∧
    tidSol.tight (tidT k).2.2 k = true := by decide +kernel

lemma tid_lt : ∀ e, tidSol.fi e < tidSol.fj e := by decide +kernel

lemma tid_inj : ∀ e e', tidSol.fi e = tidSol.fi e' → tidSol.fj e = tidSol.fj e' → e = e' := by decide +kernel

lemma tid_tight : ∀ e, tidSol.tight (tidSol.fi e) (tidSol.vk e) = true ∧
    tidSol.tight (tidSol.fi e) (tidSol.vl e) = true ∧ tidSol.tight (tidSol.fj e) (tidSol.vk e) = true ∧
    tidSol.tight (tidSol.fj e) (tidSol.vl e) = true := by decide +kernel

lemma tid_other : ∀ e m, m ≠ tidSol.fi e → m ≠ tidSol.fj e →
    tidSol.below m (tidSol.vk e) = true ∨ tidSol.below m (tidSol.vl e) = true := by decide +kernel

lemma tid_cov : ∀ i j, i < j → tidSol.certOK i j (tidCt i j) = true := by decide +kernel

theorem tid_isEdgeData : IsEdgeData tidN tidB tidP tidFi tidFj tidVk tidVl := by
  rw [tidN_eq, tidB_eq]
  exact tidSol.isEdgeData_of (by norm_num) (tidSol.bounded_of (by norm_num) tidBd tid_bd) tid_mem tidT
    tid_three tid_lt tid_inj tid_tight tid_other tidCt tid_cov

/-- The kinds of edges, by the Gram values (⟪n i, n j⟫, ⟪n i, n i⟫, ⟪n j, n j⟫) of their two faces. -/
def tidKdL : List (Fin 5) :=
  [0, 0, 0, 0, 0, 1, 2, 2, 2, 2, 0, 0, 0, 0, 0, 1, 2, 2, 2, 2, 0, 0, 0, 0, 0, 1, 2, 2, 2, 2, 0, 0, 0, 0, 0, 1, 2, 2, 2, 2, 0, 0, 0, 0, 0, 1, 2, 2, 2, 2, 0, 0, 0, 0, 0, 1, 2, 2, 2, 2, 0, 0, 0, 0, 0, 1, 2, 2, 2, 2, 0, 0, 0, 0, 0, 1, 2, 2, 2, 2, 0, 0, 0, 0, 0, 1, 2, 2, 2, 2, 0, 0, 0, 0, 0, 1, 2, 2, 2, 2, 0, 0, 0, 0, 0, 1, 2, 2, 2, 2, 0, 0, 0, 0, 0, 1, 2, 2, 2, 2, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 4, 3, 3, 4, 3, 3, 4, 3, 3, 4, 3, 3, 4, 3, 3, 4, 3, 3, 4, 3, 3, 4, 3, 3, 4, 3, 3, 4, 3, 3, 4, 3, 3, 4, 3, 3]
def tidKd (i : Fin 180) : Fin 5 := tidKdL.getD i.val 0
noncomputable def tidGg : Fin 5 → ℝ := ![(6 + 2 * √5), (2 + 2 * √5), (12 + 4 * √5), (12 + 4 * √5), (2 + 2 * √5)]
noncomputable def tidGX : Fin 5 → ℝ := ![(10 + 2 * √5), (10 + 2 * √5), (10 + 2 * √5), 12, 12]
noncomputable def tidGY : Fin 5 → ℝ := ![12, 4, (24 + 8 * √5), (24 + 8 * √5), 4]
def tidGgC : Fin 5 → Zd := ![(6, 2), (2, 2), (12, 4), (12, 4), (2, 2)]
def tidGXC : Fin 5 → Zd := ![(10, 2), (10, 2), (10, 2), (12, 0), (12, 0)]
def tidGYC : Fin 5 → Zd := ![(12, 0), (4, 0), (24, 8), (24, 8), (4, 0)]

lemma tid_gram (e : Fin 180) : ⟪tidN (tidFi e), tidN (tidFj e)⟫ = tidGg (tidKd e) ∧
    ⟪tidN (tidFi e), tidN (tidFi e)⟫ = tidGX (tidKd e) ∧ ⟪tidN (tidFj e), tidN (tidFj e)⟫ = tidGY (tidKd e) := by
  have hc : ∀ e, zdot 5 (tidSol.N (tidFi e)) (tidSol.N (tidFj e)) = tidGgC (tidKd e) ∧
      zdot 5 (tidSol.N (tidFi e)) (tidSol.N (tidFi e)) = tidGXC (tidKd e) ∧
      zdot 5 (tidSol.N (tidFj e)) (tidSol.N (tidFj e)) = tidGYC (tidKd e) := by decide +kernel
  have hv : ∀ k, ev 5 (tidGgC k) = tidGg k ∧ ev 5 (tidGXC k) = tidGX k ∧ ev 5 (tidGYC k) = tidGY k := by
    intro k; fin_cases k <;> refine ⟨?_, ?_, ?_⟩ <;> simp [ev, tidGgC, tidGXC, tidGYC, tidGg, tidGX, tidGY] <;> ring
  obtain ⟨h1, h2, h3⟩ := hc e
  obtain ⟨v1, v2, v3⟩ := hv (tidKd e)
  rw [tidN_eq, Solid.inner_n, Solid.inner_n, Solid.inner_n]
  exact ⟨by rw [h1, v1], by rw [h2, v2], by rw [h3, v3]⟩

/-- The two normals at each edge are not parallel (`⟪u, v⟫² < ⟪u, u⟫ ⟪v, v⟫`). -/
lemma tid_gram_lt (e : Fin 180) : ⟪tidN (tidFi e), tidN (tidFj e)⟫ ^ 2 <
    ⟪tidN (tidFi e), tidN (tidFi e)⟫ * ⟪tidN (tidFj e), tidN (tidFj e)⟫ := by
  have hc : ∀ e, zpos 5 (zsub (zmul 5 (zdot 5 (tidSol.N (tidFi e)) (tidSol.N (tidFi e)))
      (zdot 5 (tidSol.N (tidFj e)) (tidSol.N (tidFj e))))
      (zmul 5 (zdot 5 (tidSol.N (tidFi e)) (tidSol.N (tidFj e)))
        (zdot 5 (tidSol.N (tidFi e)) (tidSol.N (tidFj e))))) = true := by decide +kernel
  have h := zpos_spec (by norm_num) (hc e)
  rw [ev_sub, ev_mul, ev_mul] at h
  rw [tidN_eq, Solid.inner_n, Solid.inner_n, Solid.inner_n, sq]
  linarith

