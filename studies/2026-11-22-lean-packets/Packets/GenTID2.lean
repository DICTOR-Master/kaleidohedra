lemma tidT_spec : ∀ k, (tidT k).1 ≠ (tidT k).2.1 ∧ (tidT k).1 ≠ (tidT k).2.2 ∧
    (tidT k).2.1 ≠ (tidT k).2.2 ∧ tidZ (tidT k).1 k = true ∧ tidZ (tidT k).2.1 k = true ∧
    tidZ (tidT k).2.2 k = true := by decide +kernel

lemma tidE_lt : ∀ e, tidFi e < tidFj e := by decide +kernel

lemma tidE_inj : ∀ e e', tidFi e = tidFi e' → tidFj e = tidFj e' → e = e' := by decide +kernel

lemma tidE_tight : ∀ e, tidZ (tidFi e) (tidVk e) = true ∧ tidZ (tidFi e) (tidVl e) = true ∧
    tidZ (tidFj e) (tidVk e) = true ∧ tidZ (tidFj e) (tidVl e) = true := by decide +kernel

lemma tidE_other : ∀ e m, m ≠ tidFi e → m ≠ tidFj e →
    tidZ m (tidVk e) = false ∨ tidZ m (tidVl e) = false := by decide +kernel

/-- The statement of `IsEdgeData.cover`. -/
def tidCover (x : R3) (i j : Fin 62) : Prop :=
  (∃ e, ({i, j} : Set (Fin 62)) = {tidFi e, tidFj e} ∧
    x ∈ segment ℝ (tidP (tidVk e)) (tidP (tidVl e))) ∨ ∃ k, x = tidP k

