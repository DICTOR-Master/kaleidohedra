lemma tid_tight (m : Fin 62) (k : Fin 120) (h : tidZ m k = true) : ⟪tidN m, tidP k⟫ = tidB m := by
  have h1 := tid_slack m k
  have h2 := (tidS_spec m k).1 h
  linarith

lemma tid_lt (m : Fin 62) (k : Fin 120) (h : tidZ m k = false) : ⟪tidN m, tidP k⟫ < tidB m := by
  have h1 := tid_slack m k
  have h2 := (tidS_spec m k).2 h
  linarith

lemma tid_le (m : Fin 62) (k : Fin 120) : ⟪tidN m, tidP k⟫ ≤ tidB m := by
  cases h : tidZ m k
  · exact (tid_lt m k h).le
  · exact (tid_tight m k h).le

