lemma pyrIS_spec_3 (k : Fin 4) :
    (pyrIZ 3 k = true → pyrIS 3 k = 0) ∧ (pyrIZ 3 k = false → 0 < pyrIS 3 k) := by
  have h1 := sqrt5_gt; have h2 := sqrt5_lt
  fin_cases k <;> simp [pyrIZ, pyrIS] <;> linarith

lemma pyrIS_spec (m : Fin 4) (k : Fin 4) :
    (pyrIZ m k = true → pyrIS m k = 0) ∧ (pyrIZ m k = false → 0 < pyrIS m k) := by
  fin_cases m
  · exact pyrIS_spec_0 k
  · exact pyrIS_spec_1 k
  · exact pyrIS_spec_2 k
  · exact pyrIS_spec_3 k

lemma pyrI_tight (m : Fin 4) (k : Fin 4) (h : pyrIZ m k = true) : ⟪pyrIN m, pyrIP k⟫ = pyrIB m := by
  have h1 := pyrI_slack m k
  have h2 := (pyrIS_spec m k).1 h
  linarith

lemma pyrI_lt (m : Fin 4) (k : Fin 4) (h : pyrIZ m k = false) : ⟪pyrIN m, pyrIP k⟫ < pyrIB m := by
  have h1 := pyrI_slack m k
  have h2 := (pyrIS_spec m k).2 h
  linarith

lemma pyrI_le (m : Fin 4) (k : Fin 4) : ⟪pyrIN m, pyrIP k⟫ ≤ pyrIB m := by
  cases h : pyrIZ m k
  · exact (pyrI_lt m k h).le
  · exact (pyrI_tight m k h).le

/-- The face inequalities in coordinates. -/
lemma pyrI_ineqs {x : R3} (hx : x ∈ sol pyrIN pyrIB) :
    2 * x 0 + 2 * x 1 + 2 * x 2 ≤ (6 + 2 * √5) ∧
    (-4) * x 0 + (-6 - 2 * √5) * x 1 + (2 + 2 * √5) * x 2 ≤ 0 ∧
    (-6 - 2 * √5) * x 0 + (2 + 2 * √5) * x 1 + (-4) * x 2 ≤ 0 ∧
    (2 + 2 * √5) * x 0 + (-4) * x 1 + (-6 - 2 * √5) * x 2 ≤ 0 :=
  ⟨by have h := hx 0; simp [pyrIN, pyrIB, inner3] at h; linarith,
   by have h := hx 1; simp [pyrIN, pyrIB, inner3] at h; linarith,
   by have h := hx 2; simp [pyrIN, pyrIB, inner3] at h; linarith,
   by have h := hx 3; simp [pyrIN, pyrIB, inner3] at h; linarith⟩

/-- The 6 edges: the two faces of each edge … -/
def pyrIFi : Fin 6 → Fin 4 := ![0, 0, 0, 1, 1, 2]
def pyrIFj : Fin 6 → Fin 4 := ![1, 2, 3, 2, 3, 3]
/-- … and its two corners. -/
def pyrIVk : Fin 6 → Fin 4 := ![1, 1, 2, 0, 0, 0]
def pyrIVl : Fin 6 → Fin 4 := ![2, 3, 3, 1, 2, 3]

/-- Three faces through each corner. -/
def pyrIT : Fin 4 → Fin 4 × Fin 4 × Fin 4 :=
  ![(1, 2, 3), (0, 1, 2), (0, 1, 3), (0, 2, 3)]

lemma pyrIT_spec : ∀ k, (pyrIT k).1 ≠ (pyrIT k).2.1 ∧ (pyrIT k).1 ≠ (pyrIT k).2.2 ∧
    (pyrIT k).2.1 ≠ (pyrIT k).2.2 ∧ pyrIZ (pyrIT k).1 k = true ∧ pyrIZ (pyrIT k).2.1 k = true ∧
    pyrIZ (pyrIT k).2.2 k = true := by decide

lemma pyrIE_lt : ∀ e, pyrIFi e < pyrIFj e := by decide

lemma pyrIE_inj : ∀ e e', pyrIFi e = pyrIFi e' → pyrIFj e = pyrIFj e' → e = e' := by decide

lemma pyrIE_tight : ∀ e, pyrIZ (pyrIFi e) (pyrIVk e) = true ∧ pyrIZ (pyrIFi e) (pyrIVl e) = true ∧
    pyrIZ (pyrIFj e) (pyrIVk e) = true ∧ pyrIZ (pyrIFj e) (pyrIVl e) = true := by decide

lemma pyrIE_other : ∀ e m, m ≠ pyrIFi e → m ≠ pyrIFj e →
    pyrIZ m (pyrIVk e) = false ∨ pyrIZ m (pyrIVl e) = false := by decide

/-- The statement of `IsEdgeData.cover`. -/
def pyrICover (x : R3) (i j : Fin 4) : Prop :=
  (∃ e, ({i, j} : Set (Fin 4)) = {pyrIFi e, pyrIFj e} ∧
    x ∈ segment ℝ (pyrIP (pyrIVk e)) (pyrIP (pyrIVl e))) ∨ ∃ k, x = pyrIP k

