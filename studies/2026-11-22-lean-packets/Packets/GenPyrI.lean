    ∀ i j : Fin 4, i < j → ⟪pyrIN i, x⟫ = pyrIB i → ⟪pyrIN j, x⟫ = pyrIB j → pyrICover x i j := by
  intro i j hij hi hj
  fin_cases i <;> fin_cases j
  · exact absurd hij (by decide)
  · exact pyrI_cover_0_1 hx hi hj
  · exact pyrI_cover_0_2 hx hi hj
  · exact pyrI_cover_0_3 hx hi hj
  · exact absurd hij (by decide)
  · exact absurd hij (by decide)
  · exact pyrI_cover_1_2 hx hi hj
  · exact pyrI_cover_1_3 hx hi hj
  · exact absurd hij (by decide)
  · exact absurd hij (by decide)
  · exact absurd hij (by decide)
