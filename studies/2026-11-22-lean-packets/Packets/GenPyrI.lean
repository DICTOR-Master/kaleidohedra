/-
Generated by gen/gen_pieces.py (pyrI), adapted from the Dehn Canon's checks/gen_edges5.py: exact arithmetic in
Q(sqrt5), every fact checked in Python first and again by Lean, by evaluation on integer codes (Packets.Exact).
Edge data (`IsEdgeData`), interior point, boundedness and the Gram values of the face normals at each edge.
No `sorry`.
-/
module

public import Packets.Exact

@[expose] public section

open scoped RealInnerProductSpace Real
open Set Module

namespace PacketsGen

open DehnCanon.Library

set_option maxRecDepth 20000
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- Outward face normals. -/
noncomputable def pyrIN : Fin 4 → R3 :=
  ![!₂[2, 2, 2], !₂[(-4), (-6 - 2 * √5), (2 + 2 * √5)], !₂[(-6 - 2 * √5), (2 + 2 * √5), (-4)], !₂[(2 + 2 * √5), (-4), (-6 - 2 * √5)]]

/-- Offsets. -/
noncomputable def pyrIB : Fin 4 → ℝ := ![(6 + 2 * √5), 0, 0, 0]

/-- The solid. -/
def pyrISet : Set R3 := sol pyrIN pyrIB

/-- Integer codes of the normals, offsets and corners (`x.1 + x.2 √5`). -/
def pyrINc : Fin 4 → V3 :=
  ![![(2, 0), (2, 0), (2, 0)],
    ![(-4, 0), (-6, -2), (2, 2)],
    ![(-6, -2), (2, 2), (-4, 0)],
    ![(2, 2), (-4, 0), (-6, -2)]]
def pyrIBc : Fin 4 → Zd := ![(6, 2), (0, 0), (0, 0), (0, 0)]
def pyrIPc : Fin 4 → V3 :=
  ![![(0, 0), (0, 0), (0, 0)],
    ![(0, 0), (2, 0), (1, 1)],
    ![(1, 1), (0, 0), (2, 0)],
    ![(2, 0), (1, 1), (0, 0)]]

/-- The 6 edges: the two faces of each edge and its two corners. -/
def pyrIFi : Fin 6 → Fin 4 := ![0, 0, 0, 1, 1, 2]
def pyrIFj : Fin 6 → Fin 4 := ![1, 2, 3, 2, 3, 3]
def pyrIVk : Fin 6 → Fin 4 := ![1, 1, 2, 0, 0, 0]
def pyrIVl : Fin 6 → Fin 4 := ![2, 3, 3, 1, 2, 3]

/-- Three faces through each corner. -/
def pyrIT : Fin 4 → Fin 4 × Fin 4 × Fin 4 :=
  ![(1, 2, 3), (0, 1, 2), (0, 1, 3), (0, 2, 3)]

def pyrISol : Solid 5 4 4 6 := ⟨pyrINc, pyrIBc, pyrIPc, pyrIFi, pyrIFj, pyrIVk, pyrIVl⟩

/-- Corners. -/
noncomputable def pyrIP : Fin 4 → R3 := pyrISol.p

/-- How each two faces meet (edge, corner, or a Farkas certificate that they do not). -/
def pyrICt : Fin 4 → Fin 4 → Cert 4 4 6 :=
  ![![.none, .edge 0 3 2, .edge 1 3 1, .edge 2 2 1],
    ![.none, .none, .edge 3 0 3, .edge 4 0 2],
    ![.none, .none, .none, .edge 5 0 1],
    ![.none, .none, .none, .none]]

/-- Bounds along the six axis directions. -/
def pyrIBd : Fin 6 → BCert 4 := ![⟨0, 1, 3, (-4, 4), (-4, 2), (-1, 1), (16, 0)⟩, ⟨0, 1, 2, (0, 0), (3, -1), (-1, 1), (16, 0)⟩, ⟨0, 2, 3, (-4, 4), (-1, 1), (-4, 2), (16, 0)⟩, ⟨0, 1, 3, (0, 0), (-1, 1), (3, -1), (16, 0)⟩, ⟨0, 1, 2, (-4, 4), (-1, 1), (-4, 2), (16, 0)⟩, ⟨0, 2, 3, (0, 0), (3, -1), (-1, 1), (16, 0)⟩]

/-- An interior point (times 6). -/
def pyrIZc : V3 := ![(3, 1), (3, 1), (3, 1)]

lemma pyrIN_eq : pyrIN = pyrISol.n := by
  funext m; fin_cases m <;> ext t <;> fin_cases t <;>
    simp [pyrIN, pyrISol, pyrINc, Solid.n, evv, ev] <;> ring

lemma pyrIB_eq : pyrIB = pyrISol.b := by
  funext m; fin_cases m <;> simp [pyrIB, pyrISol, pyrIBc, Solid.b, ev] <;> ring

theorem pyrI_bounded : Bornology.IsBounded (sol pyrIN pyrIB) := by
  rw [pyrIN_eq, pyrIB_eq]; exact pyrISol.bounded_of (by norm_num) pyrIBd (by decide +kernel)

theorem isPoly_pyrI : DehnCanon.Library.IsPoly pyrISet := ⟨pyrI_bounded, Fin 4, inferInstance, pyrIN, _, rfl⟩

theorem pyrI_interior : (interior (sol pyrIN pyrIB)).Nonempty := by
  rw [pyrIN_eq, pyrIB_eq]; exact pyrISol.interior_of (by norm_num) pyrIZc (6, 0) (by decide +kernel) (by decide +kernel)

theorem pyrI_isEdgeData : IsEdgeData pyrIN pyrIB pyrIP pyrIFi pyrIFj pyrIVk pyrIVl := by
  rw [pyrIN_eq, pyrIB_eq]
  exact pyrISol.isEdgeData_of (by norm_num) (pyrISol.bounded_of (by norm_num) pyrIBd (by decide +kernel))
    (by decide +kernel) pyrIT (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) pyrICt (by decide +kernel)

/-- The kinds of edges, by the Gram values (⟪n i, n j⟫, ⟪n i, n i⟫, ⟪n j, n j⟫) of their two faces. -/
def pyrIKd : Fin 6 → Fin 2 := ![0, 0, 0, 1, 1, 1]
noncomputable def pyrIGg : Fin 2 → ℝ := ![(-16), (-16 - 16 * √5)]
noncomputable def pyrIGX : Fin 2 → ℝ := ![12, (96 + 32 * √5)]
noncomputable def pyrIGY : Fin 2 → ℝ := ![(96 + 32 * √5), (96 + 32 * √5)]
def pyrIGgC : Fin 2 → Zd := ![(-16, 0), (-16, -16)]
def pyrIGXC : Fin 2 → Zd := ![(12, 0), (96, 32)]
def pyrIGYC : Fin 2 → Zd := ![(96, 32), (96, 32)]

lemma pyrI_gram (e : Fin 6) : ⟪pyrIN (pyrIFi e), pyrIN (pyrIFj e)⟫ = pyrIGg (pyrIKd e) ∧
    ⟪pyrIN (pyrIFi e), pyrIN (pyrIFi e)⟫ = pyrIGX (pyrIKd e) ∧ ⟪pyrIN (pyrIFj e), pyrIN (pyrIFj e)⟫ = pyrIGY (pyrIKd e) := by
  have hc : ∀ e, zdot 5 (pyrISol.N (pyrIFi e)) (pyrISol.N (pyrIFj e)) = pyrIGgC (pyrIKd e) ∧
      zdot 5 (pyrISol.N (pyrIFi e)) (pyrISol.N (pyrIFi e)) = pyrIGXC (pyrIKd e) ∧
      zdot 5 (pyrISol.N (pyrIFj e)) (pyrISol.N (pyrIFj e)) = pyrIGYC (pyrIKd e) := by decide +kernel
  have hv : ∀ k, ev 5 (pyrIGgC k) = pyrIGg k ∧ ev 5 (pyrIGXC k) = pyrIGX k ∧ ev 5 (pyrIGYC k) = pyrIGY k := by
    intro k; fin_cases k <;> refine ⟨?_, ?_, ?_⟩ <;> simp [ev, pyrIGgC, pyrIGXC, pyrIGYC, pyrIGg, pyrIGX, pyrIGY] <;> ring
  obtain ⟨h1, h2, h3⟩ := hc e
  obtain ⟨v1, v2, v3⟩ := hv (pyrIKd e)
  rw [pyrIN_eq, Solid.inner_n, Solid.inner_n, Solid.inner_n]
  exact ⟨by rw [h1, v1], by rw [h2, v2], by rw [h3, v3]⟩

/-- The two normals at each edge are not parallel (`⟪u, v⟫² < ⟪u, u⟫ ⟪v, v⟫`). -/
lemma pyrI_gram_lt (e : Fin 6) : ⟪pyrIN (pyrIFi e), pyrIN (pyrIFj e)⟫ ^ 2 <
    ⟪pyrIN (pyrIFi e), pyrIN (pyrIFi e)⟫ * ⟪pyrIN (pyrIFj e), pyrIN (pyrIFj e)⟫ := by
  have hc : ∀ e, zpos 5 (zsub (zmul 5 (zdot 5 (pyrISol.N (pyrIFi e)) (pyrISol.N (pyrIFi e)))
      (zdot 5 (pyrISol.N (pyrIFj e)) (pyrISol.N (pyrIFj e))))
      (zmul 5 (zdot 5 (pyrISol.N (pyrIFi e)) (pyrISol.N (pyrIFj e)))
        (zdot 5 (pyrISol.N (pyrIFi e)) (pyrISol.N (pyrIFj e))))) = true := by decide +kernel
  have h := zpos_spec (by norm_num) (hc e)
  rw [ev_sub, ev_mul, ev_mul] at h
  rw [pyrIN_eq, Solid.inner_n, Solid.inner_n, Solid.inner_n, sq]
  linarith

end PacketsGen

