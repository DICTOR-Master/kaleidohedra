/-- Outward face normals. -/
noncomputable def pyrIN : Fin 4 → R3 :=
  ![!₂[2, 2, 2],
    !₂[(-4), (-6 - 2 * √5), (2 + 2 * √5)],
    !₂[(-6 - 2 * √5), (2 + 2 * √5), (-4)],
    !₂[(2 + 2 * √5), (-4), (-6 - 2 * √5)]]

/-- Offsets. -/
noncomputable def pyrIB : Fin 4 → ℝ := ![(6 + 2 * √5), 0, 0, 0]

/-- Corners. -/
noncomputable def pyrIP : Fin 4 → R3 :=
  ![!₂[0, 0, 0],
    !₂[0, 2, (1 + √5)],
    !₂[(1 + √5), 0, 2],
    !₂[2, (1 + √5), 0]]

/-- The table "face `m` passes through corner `k`". -/
def pyrIZ : Fin 4 → Fin 4 → Bool :=
  ![![false, true, true, true],
    ![true, true, true, false],
    ![true, true, false, true],
    ![true, false, true, true]]

/-- The values `b m − ⟪n m, p k⟫`. -/
noncomputable def pyrIS : Fin 4 → Fin 4 → ℝ :=
  ![![(6 + 2 * √5), 0, 0, 0],
    ![0, 0, 0, (24 + 8 * √5)],
    ![0, 0, (24 + 8 * √5), 0],
    ![0, (24 + 8 * √5), 0, 0]]

lemma pyrI_slack_0 (k : Fin 4) : pyrIB 0 - ⟪pyrIN 0, pyrIP k⟫ = pyrIS 0 k := by
  have ht := sqrt5_sq
  fin_cases k <;> simp [pyrIB, pyrIN, pyrIP, pyrIS, inner3] <;> grind

lemma pyrI_slack_1 (k : Fin 4) : pyrIB 1 - ⟪pyrIN 1, pyrIP k⟫ = pyrIS 1 k := by
  have ht := sqrt5_sq
  fin_cases k <;> simp [pyrIB, pyrIN, pyrIP, pyrIS, inner3] <;> grind

lemma pyrI_slack_2 (k : Fin 4) : pyrIB 2 - ⟪pyrIN 2, pyrIP k⟫ = pyrIS 2 k := by
  have ht := sqrt5_sq
  fin_cases k <;> simp [pyrIB, pyrIN, pyrIP, pyrIS, inner3] <;> grind

lemma pyrI_slack_3 (k : Fin 4) : pyrIB 3 - ⟪pyrIN 3, pyrIP k⟫ = pyrIS 3 k := by
  have ht := sqrt5_sq
  fin_cases k <;> simp [pyrIB, pyrIN, pyrIP, pyrIS, inner3] <;> grind

lemma pyrI_slack (m : Fin 4) (k : Fin 4) : pyrIB m - ⟪pyrIN m, pyrIP k⟫ = pyrIS m k := by
  fin_cases m
  · exact pyrI_slack_0 k
  · exact pyrI_slack_1 k
  · exact pyrI_slack_2 k
  · exact pyrI_slack_3 k

lemma pyrIS_spec_0 (k : Fin 4) :
    (pyrIZ 0 k = true → pyrIS 0 k = 0) ∧ (pyrIZ 0 k = false → 0 < pyrIS 0 k) := by
  have h1 := sqrt5_gt; have h2 := sqrt5_lt
  fin_cases k <;> simp [pyrIZ, pyrIS] <;> linarith

lemma pyrIS_spec_1 (k : Fin 4) :
    (pyrIZ 1 k = true → pyrIS 1 k = 0) ∧ (pyrIZ 1 k = false → 0 < pyrIS 1 k) := by
  have h1 := sqrt5_gt; have h2 := sqrt5_lt
  fin_cases k <;> simp [pyrIZ, pyrIS] <;> linarith

lemma pyrIS_spec_2 (k : Fin 4) :
