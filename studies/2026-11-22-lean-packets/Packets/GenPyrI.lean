lemma pyrI_cover {x : R3} (hx : x ∈ sol pyrIN pyrIB) (i j : Fin 4) (hij : i ≠ j)
    (hi : ⟪pyrIN i, x⟫ = pyrIB i) (hj : ⟪pyrIN j, x⟫ = pyrIB j) : pyrICover x i j := by
  rcases lt_or_gt_of_ne hij with h | h
  · exact pyrI_cover_lt hx i j h hi hj
  · rcases pyrI_cover_lt hx j i h hj hi with ⟨e, he, hseg⟩ | hk
    · exact Or.inl ⟨e, (Set.pair_comm i j).trans he, hseg⟩
    · exact Or.inr hk

lemma pyrI_le_of_comb3 {c₁ c₂ c₃ : Fin 4} {μ₁ μ₂ μ₃ : ℝ} {d : R3} (h₁ : 0 ≤ μ₁) (h₂ : 0 ≤ μ₂)
    (h₃ : 0 ≤ μ₃) (hrel : d = μ₁ • pyrIN c₁ + μ₂ • pyrIN c₂ + μ₃ • pyrIN c₃) {x : R3} (hx : x ∈ sol pyrIN pyrIB) :
    ⟪d, x⟫ ≤ μ₁ * pyrIB c₁ + μ₂ * pyrIB c₂ + μ₃ * pyrIB c₃ := by
  rw [hrel, inner_add_left, inner_add_left, real_inner_smul_left, real_inner_smul_left, real_inner_smul_left]
  have e1 := mul_le_mul_of_nonneg_left (hx c₁) h₁
  have e2 := mul_le_mul_of_nonneg_left (hx c₂) h₂
  have e3 := mul_le_mul_of_nonneg_left (hx c₃) h₃
  linarith


/-- An interior point. -/
noncomputable def pyrIZ0 : R3 := !₂[((1 / 2) + (1 / 6) * √5), ((1 / 2) + (1 / 6) * √5), ((1 / 2) + (1 / 6) * √5)]

noncomputable def pyrISZ : Fin 4 → ℝ := ![(3 + √5), (4 + (4 / 3) * √5), (4 + (4 / 3) * √5), (4 + (4 / 3) * √5)]

lemma pyrI_int_slack (m : Fin 4) : pyrIB m - ⟪pyrIN m, pyrIZ0⟫ = pyrISZ m := by
  have ht := sqrt5_sq
  fin_cases m <;> simp [pyrIB, pyrIN, pyrIZ0, pyrISZ, inner3] <;> grind

lemma pyrISZ_pos (m : Fin 4) : 0 < pyrISZ m := by
  fin_cases m <;> simp [pyrISZ] <;> s5pos

theorem pyrI_interior : (interior (sol pyrIN pyrIB)).Nonempty := by
  refine ⟨pyrIZ0, mem_interior_iff_mem_nhds.2 (Filter.mem_of_superset ((isOpen_iInter_of_finite
    fun m => isOpen_lt (by fun_prop : Continuous fun x : R3 => ⟪pyrIN m, x⟫) continuous_const).mem_nhds
    (Set.mem_iInter.2 fun m => ?_)) fun x hx m => (Set.mem_iInter.1 hx m).le)⟩
  have h1 := pyrI_int_slack m
  have h2 := pyrISZ_pos m
  show ⟪pyrIN m, pyrIZ0⟫ < pyrIB m
  linarith

def pyrISet : Set R3 := sol pyrIN pyrIB

theorem pyrI_bounded : Bornology.IsBounded (sol pyrIN pyrIB) := by
  refine bounded_of_coords 4 (fun x hx i => ?_)
  have h1 := sqrt5_gt; have h2 := sqrt5_lt; have h5 := sqrt5_sq
  have b0p := pyrI_le_of_comb3 (d := !₂[1, 0, 0]) (c₁ := 0) (c₂ := 1) (c₃ := 3)
    (μ₁ := (-(1 / 4) + (1 / 4) * √5)) (μ₂ := (-(1 / 4) + (1 / 8) * √5)) (μ₃ := (-(1 / 16) + (1 / 16) * √5)) (by s5nn) (by s5nn) (by s5nn)
    (by have ht := sqrt5_sq; ext t; fin_cases t <;> simp [pyrIN] <;> grind) hx
  simp only [pyrIB, inner3] at b0p
  norm_num at b0p
  have b0m := pyrI_le_of_comb3 (d := !₂[(-1), 0, 0]) (c₁ := 0) (c₂ := 1) (c₃ := 2)
    (μ₁ := 0) (μ₂ := ((3 / 16) - (1 / 16) * √5)) (μ₃ := (-(1 / 16) + (1 / 16) * √5)) (by s5nn) (by s5nn) (by s5nn)
    (by have ht := sqrt5_sq; ext t; fin_cases t <;> simp [pyrIN] <;> grind) hx
  simp only [pyrIB, inner3] at b0m
  norm_num at b0m
  have b1p := pyrI_le_of_comb3 (d := !₂[0, 1, 0]) (c₁ := 0) (c₂ := 2) (c₃ := 3)
    (μ₁ := (-(1 / 4) + (1 / 4) * √5)) (μ₂ := (-(1 / 16) + (1 / 16) * √5)) (μ₃ := (-(1 / 4) + (1 / 8) * √5)) (by s5nn) (by s5nn) (by s5nn)
    (by have ht := sqrt5_sq; ext t; fin_cases t <;> simp [pyrIN] <;> grind) hx
  simp only [pyrIB, inner3] at b1p
  norm_num at b1p
  have b1m := pyrI_le_of_comb3 (d := !₂[0, (-1), 0]) (c₁ := 0) (c₂ := 1) (c₃ := 3)
    (μ₁ := 0) (μ₂ := (-(1 / 16) + (1 / 16) * √5)) (μ₃ := ((3 / 16) - (1 / 16) * √5)) (by s5nn) (by s5nn) (by s5nn)
    (by have ht := sqrt5_sq; ext t; fin_cases t <;> simp [pyrIN] <;> grind) hx
  simp only [pyrIB, inner3] at b1m
  norm_num at b1m
  have b2p := pyrI_le_of_comb3 (d := !₂[0, 0, 1]) (c₁ := 0) (c₂ := 1) (c₃ := 2)
    (μ₁ := (-(1 / 4) + (1 / 4) * √5)) (μ₂ := (-(1 / 16) + (1 / 16) * √5)) (μ₃ := (-(1 / 4) + (1 / 8) * √5)) (by s5nn) (by s5nn) (by s5nn)
    (by have ht := sqrt5_sq; ext t; fin_cases t <;> simp [pyrIN] <;> grind) hx
  simp only [pyrIB, inner3] at b2p
  norm_num at b2p
  have b2m := pyrI_le_of_comb3 (d := !₂[0, 0, (-1)]) (c₁ := 0) (c₂ := 2) (c₃ := 3)
    (μ₁ := 0) (μ₂ := ((3 / 16) - (1 / 16) * √5)) (μ₃ := (-(1 / 16) + (1 / 16) * √5)) (by s5nn) (by s5nn) (by s5nn)
    (by have ht := sqrt5_sq; ext t; fin_cases t <;> simp [pyrIN] <;> grind) hx
  simp only [pyrIB, inner3] at b2m
  norm_num at b2m

  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] <;> rw [abs_le] <;>
    constructor <;> linarith

theorem isPoly_pyrI : DehnCanon.Library.IsPoly pyrISet := ⟨pyrI_bounded, Fin 4, inferInstance, pyrIN, _, rfl⟩

theorem pyrI_isEdgeData : IsEdgeData pyrIN pyrIB pyrIP pyrIFi pyrIFj pyrIVk pyrIVl where
  bounded := pyrI_bounded
  corner_mem := fun k m => pyrI_le m k
  corner_three := fun k => by
    obtain ⟨h1, h2, h3, t1, t2, t3⟩ := pyrIT_spec k
    exact ⟨_, _, _, h1, h2, h3, pyrI_tight _ _ t1, pyrI_tight _ _ t2, pyrI_tight _ _ t3⟩
  faces_ne := fun e => (pyrIE_lt e).ne
  faces_inj := fun e e' h => by
    rcases Set.pair_eq_pair_iff.1 h with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact pyrIE_inj e e' h1 h2
    · have a := pyrIE_lt e
      rw [h1, h2] at a
      exact absurd a (lt_asymm (pyrIE_lt e'))
  tight := fun e => by
    obtain ⟨t1, t2, t3, t4⟩ := pyrIE_tight e
    exact ⟨pyrI_tight _ _ t1, pyrI_tight _ _ t2, pyrI_tight _ _ t3, pyrI_tight _ _ t4⟩
  other := fun e m h1 h2 => by
    rcases pyrIE_other e m h1 h2 with h | h
    · exact Or.inl (pyrI_lt _ _ h)
    · exact Or.inr (pyrI_lt _ _ h)
  cover := fun x hx i j hij hi hj => pyrI_cover hx i j hij hi hj

/-- The kinds of edges, by the Gram values (⟪n i, n j⟫, ⟪n i, n i⟫, ⟪n j, n j⟫) of their two faces. -/
def pyrIKd : Fin 6 → Fin 2 := ![0, 0, 0, 1, 1, 1]
noncomputable def pyrIGg : Fin 2 → ℝ := ![(-16), (-16 - 16 * √5)]
noncomputable def pyrIGX : Fin 2 → ℝ := ![12, (96 + 32 * √5)]
noncomputable def pyrIGY : Fin 2 → ℝ := ![(96 + 32 * √5), (96 + 32 * √5)]

lemma pyrI_gram (e : Fin 6) : ⟪pyrIN (pyrIFi e), pyrIN (pyrIFj e)⟫ = pyrIGg (pyrIKd e) ∧
    ⟪pyrIN (pyrIFi e), pyrIN (pyrIFi e)⟫ = pyrIGX (pyrIKd e) ∧ ⟪pyrIN (pyrIFj e), pyrIN (pyrIFj e)⟫ = pyrIGY (pyrIKd e) := by
  have ht := sqrt5_sq
  rw [inner3', inner3', inner3']
  fin_cases e <;> refine ⟨?_, ?_, ?_⟩ <;> simp [pyrIN, pyrIFi, pyrIFj, pyrIKd, pyrIGg, pyrIGX, pyrIGY, inner3] <;> grind

end PacketsGen
