/-- The 30 edges: the two faces of each edge … -/
def icoFi : Fin 30 → Fin 20 := ![0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5, 5, 5, 6, 6, 6, 7, 7, 7, 8, 10, 12, 13, 16, 18]
def icoFj : Fin 30 → Fin 20 := ![8, 12, 16, 9, 13, 16, 10, 12, 17, 11, 13, 17, 8, 14, 18, 9, 15, 18, 10, 14, 19, 11, 15, 19, 9, 11, 14, 15, 17, 19]
/-- … and its two corners. -/
def icoVk : Fin 30 → Fin 12 := ![0, 0, 4, 1, 1, 5, 2, 2, 4, 3, 3, 5, 0, 0, 6, 1, 1, 7, 2, 2, 6, 3, 3, 7, 8, 9, 0, 1, 4, 6]
def icoVl : Fin 30 → Fin 12 := ![8, 4, 8, 8, 5, 8, 9, 4, 9, 9, 5, 9, 10, 6, 10, 10, 7, 10, 11, 6, 11, 11, 7, 11, 10, 11, 2, 3, 5, 7]

/-- Three faces through each corner. -/
def icoT : Fin 12 → Fin 20 × Fin 20 × Fin 20 :=
  ![(0, 4, 8), (1, 5, 9), (2, 6, 10), (3, 7, 11), (0, 2, 12), (1, 3, 13), (4, 6, 14), (5, 7, 15), (0, 1, 8), (2, 3, 10), (4, 5, 8), (6, 7, 10)]

lemma icoT_spec : ∀ k, (icoT k).1 ≠ (icoT k).2.1 ∧ (icoT k).1 ≠ (icoT k).2.2 ∧
    (icoT k).2.1 ≠ (icoT k).2.2 ∧ icoZ (icoT k).1 k = true ∧ icoZ (icoT k).2.1 k = true ∧
    icoZ (icoT k).2.2 k = true := by decide

lemma icoE_lt : ∀ e, icoFi e < icoFj e := by decide

lemma icoE_inj : ∀ e e', icoFi e = icoFi e' → icoFj e = icoFj e' → e = e' := by decide

lemma icoE_tight : ∀ e, icoZ (icoFi e) (icoVk e) = true ∧ icoZ (icoFi e) (icoVl e) = true ∧
    icoZ (icoFj e) (icoVk e) = true ∧ icoZ (icoFj e) (icoVl e) = true := by decide

lemma icoE_other : ∀ e m, m ≠ icoFi e → m ≠ icoFj e →
    icoZ m (icoVk e) = false ∨ icoZ m (icoVl e) = false := by decide

/-- The statement of `IsEdgeData.cover`. -/
def icoCover (x : R3) (i j : Fin 20) : Prop :=
  (∃ e, ({i, j} : Set (Fin 20)) = {icoFi e, icoFj e} ∧
    x ∈ segment ℝ (icoP (icoVk e)) (icoP (icoVl e))) ∨ ∃ k, x = icoP k

