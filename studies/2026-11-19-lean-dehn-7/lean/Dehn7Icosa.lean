lemma ico_tight (m : Fin 20) (k : Fin 12) (h : icoZ m k = true) : ⟪icoN m, icoP k⟫ = icoB m := by
  have h1 := ico_slack m k
  have h2 := (icoS_spec m k).1 h
  linarith

lemma ico_lt (m : Fin 20) (k : Fin 12) (h : icoZ m k = false) : ⟪icoN m, icoP k⟫ < icoB m := by
  have h1 := ico_slack m k
  have h2 := (icoS_spec m k).2 h
  linarith

lemma ico_le (m : Fin 20) (k : Fin 12) : ⟪icoN m, icoP k⟫ ≤ icoB m := by
  cases h : icoZ m k
  · exact (ico_lt m k h).le
  · exact (ico_tight m k h).le

/-- The face inequalities in coordinates. -/
lemma ico_ineqs {x : R3} (hx : x ∈ sol icoN icoB) :
    2 * x 0 + 2 * x 1 + 2 * x 2 ≤ (6 + 2 * √5) ∧
    2 * x 0 + 2 * x 1 + (-2) * x 2 ≤ (6 + 2 * √5) ∧
    2 * x 0 + (-2) * x 1 + 2 * x 2 ≤ (6 + 2 * √5) ∧
    2 * x 0 + (-2) * x 1 + (-2) * x 2 ≤ (6 + 2 * √5) ∧
    (-2) * x 0 + 2 * x 1 + 2 * x 2 ≤ (6 + 2 * √5) ∧
    (-2) * x 0 + 2 * x 1 + (-2) * x 2 ≤ (6 + 2 * √5) ∧
    (-2) * x 0 + (-2) * x 1 + 2 * x 2 ≤ (6 + 2 * √5) ∧
    (-2) * x 0 + (-2) * x 1 + (-2) * x 2 ≤ (6 + 2 * √5) ∧
    0 * x 0 + (1 + √5) * x 1 + (-1 + √5) * x 2 ≤ (6 + 2 * √5) ∧
    0 * x 0 + (1 + √5) * x 1 + (1 - √5) * x 2 ≤ (6 + 2 * √5) ∧
    0 * x 0 + (-1 - √5) * x 1 + (-1 + √5) * x 2 ≤ (6 + 2 * √5) ∧
    0 * x 0 + (-1 - √5) * x 1 + (1 - √5) * x 2 ≤ (6 + 2 * √5) ∧
    (-1 + √5) * x 0 + 0 * x 1 + (1 + √5) * x 2 ≤ (6 + 2 * √5) ∧
    (-1 + √5) * x 0 + 0 * x 1 + (-1 - √5) * x 2 ≤ (6 + 2 * √5) ∧
    (1 - √5) * x 0 + 0 * x 1 + (1 + √5) * x 2 ≤ (6 + 2 * √5) ∧
    (1 - √5) * x 0 + 0 * x 1 + (-1 - √5) * x 2 ≤ (6 + 2 * √5) ∧
    (1 + √5) * x 0 + (-1 + √5) * x 1 + 0 * x 2 ≤ (6 + 2 * √5) ∧
    (1 + √5) * x 0 + (1 - √5) * x 1 + 0 * x 2 ≤ (6 + 2 * √5) ∧
    (-1 - √5) * x 0 + (-1 + √5) * x 1 + 0 * x 2 ≤ (6 + 2 * √5) ∧
    (-1 - √5) * x 0 + (1 - √5) * x 1 + 0 * x 2 ≤ (6 + 2 * √5) :=
  ⟨by have h := hx 0; simp [icoN, icoB, inner3] at h; linarith,
   by have h := hx 1; simp [icoN, icoB, inner3] at h; linarith,
   by have h := hx 2; simp [icoN, icoB, inner3] at h; linarith,
   by have h := hx 3; simp [icoN, icoB, inner3] at h; linarith,
   by have h := hx 4; simp [icoN, icoB, inner3] at h; linarith,
   by have h := hx 5; simp [icoN, icoB, inner3] at h; linarith,
   by have h := hx 6; simp [icoN, icoB, inner3] at h; linarith,
   by have h := hx 7; simp [icoN, icoB, inner3] at h; linarith,
   by have h := hx 8; simp [icoN, icoB, inner3] at h; linarith,
   by have h := hx 9; simp [icoN, icoB, inner3] at h; linarith,
   by have h := hx 10; simp [icoN, icoB, inner3] at h; linarith,
   by have h := hx 11; simp [icoN, icoB, inner3] at h; linarith,
   by have h := hx 12; simp [icoN, icoB, inner3] at h; linarith,
   by have h := hx 13; simp [icoN, icoB, inner3] at h; linarith,
