      have e : 1 * icoB 17 + 1 * icoB 19 - ((-(1 / 2) + (1 / 2) * √5) * icoB 3 + (-(1 / 2) + (1 / 2) * √5) * icoB 6 +
          0 * icoB 17) = 8 := by simp [icoB]; grind
      have h1 := sqrt5_gt; have h2 := sqrt5_lt
      linarith)
    hx hi hj).elim

lemma ico_cover_18_19 {x : R3} (hx : x ∈ sol icoN icoB) (hi : ⟪icoN 18, x⟫ = icoB 18)
