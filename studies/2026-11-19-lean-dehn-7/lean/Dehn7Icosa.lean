lemma ico_cover {x : R3} (hx : x ∈ sol icoN icoB) (i j : Fin 20) (hij : i ≠ j)
    (hi : ⟪icoN i, x⟫ = icoB i) (hj : ⟪icoN j, x⟫ = icoB j) : icoCover x i j := by
  rcases lt_or_gt_of_ne hij with h | h
  · exact ico_cover_lt hx i j h hi hj
  · rcases ico_cover_lt hx j i h hj hi with ⟨e, he, hseg⟩ | hk
    · exact Or.inl ⟨e, (Set.pair_comm i j).trans he, hseg⟩
    · exact Or.inr hk

/-- **The regular icosahedron**, as its twenty face half-spaces (normals along the corners of a dodecahedron). -/
def icoSet : Set R3 := sol icoN icoB

theorem ico_bounded : Bornology.IsBounded (sol icoN icoB) := by
  refine bounded_of_coords 6 (fun x hx i => ?_)
  have h1 := sqrt5_gt; have h2 := sqrt5_lt
  obtain ⟨e0, e1, e2, e3, e4, e5, e6, e7, -⟩ := ico_ineqs hx
  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] <;> rw [abs_le] <;>
    constructor <;> linarith

theorem isPoly_ico : IsPoly icoSet := ⟨ico_bounded, Fin 20, inferInstance, icoN, _, rfl⟩

/-- **The corners, faces and edges of the icosahedron satisfy `IsEdgeData`.** -/
theorem ico_isEdgeData : IsEdgeData icoN icoB icoP icoFi icoFj icoVk icoVl where
  bounded := ico_bounded
  corner_mem := fun k m => ico_le m k
  corner_three := fun k => by
    obtain ⟨h1, h2, h3, t1, t2, t3⟩ := icoT_spec k
    exact ⟨_, _, _, h1, h2, h3, ico_tight _ _ t1, ico_tight _ _ t2, ico_tight _ _ t3⟩
  faces_ne := fun e => (icoE_lt e).ne
  faces_inj := fun e e' h => by
    rcases Set.pair_eq_pair_iff.1 h with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact icoE_inj e e' h1 h2
    · have a := icoE_lt e
      rw [h1, h2] at a
      exact absurd a (lt_asymm (icoE_lt e'))
  tight := fun e => by
    obtain ⟨t1, t2, t3, t4⟩ := icoE_tight e
    exact ⟨ico_tight _ _ t1, ico_tight _ _ t2, ico_tight _ _ t3, ico_tight _ _ t4⟩
  other := fun e m h1 h2 => by
    rcases icoE_other e m h1 h2 with h | h
    · exact Or.inl (ico_lt _ _ h)
    · exact Or.inr (ico_lt _ _ h)
  cover := fun x hx i j hij hi hj => ico_cover hx i j hij hi hj

/-- The edges of the icosahedron all have length 4 … -/
lemma ico_dist (e : Fin 30) : dist (icoP (icoVk e)) (icoP (icoVl e)) = 4 := by
  have ht := sqrt5_sq
  apply dist3 _ _ (by norm_num)
  fin_cases e <;> simp [icoP, icoVk, icoVl] <;> grind

/-- … and all meet at the angle arccos(−√5/3) = π − γ. -/
lemma ico_theta (e : Fin 30) :
    theta (cone icoN ({icoFi e, icoFj e} : Set (Fin 20))) =
      (Submodule.Quotient.mk (π - wordGamma) : Angle) := by
  have ht := sqrt5_sq
  have key : ∀ i j : Fin 20, ⟪icoN i, icoN i⟫ = 12 → ⟪icoN j, icoN j⟫ = 12 →
      ⟪icoN i, icoN j⟫ = -(-(4 * √5)) →
      theta (cone icoN ({i, j} : Set (Fin 20))) = (Submodule.Quotient.mk (π - wordGamma) : Angle) := by
    intro i j hii hjj hij
    have hne : (12 : ℝ) * 12 ≠ (-(4 * √5)) ^ 2 := by
      rw [neg_sq, mul_pow, sqrt5_sq]; norm_num
    rw [theta_pair_of_gram icoN rfl (by norm_num) hii hjj hij hne, Real.sqrt_mul_self (by norm_num),
      show -(4 * √5) / 12 = -(√5 / 3) by ring, Real.arccos_neg]
    rfl
  fin_cases e <;> apply key <;> simp [icoN, icoFi, icoFj, inner3, norm3_sq] <;> grind

/-- **The Dehn invariant of the icosahedron**: (−120) ⊗ γ. -/
theorem dehnSet_ico : dehnSet icoSet = edgeTerm (-120) wordGamma := by
  unfold icoSet
  rw [ico_isEdgeData.dehnSet_eq]
  have h : ∀ e : Fin 30, dist (icoP (icoVk e)) (icoP (icoVl e)) ⊗ₜ[ℚ]
      theta (cone icoN ({icoFi e, icoFj e} : Set (Fin 20))) = -edgeTerm 4 wordGamma := by
    intro e
    rw [ico_dist, ico_theta, ← edgeTerm_pi_sub]; rfl
  rw [Finset.sum_congr rfl (fun e _ => h e), Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    show (-120 : ℝ) = ((-30 : ℤ) : ℝ) * 4 by norm_num, edgeTerm_int1]
  abel

/-- **The icosahedron is a nonzero word.** -/
theorem dehnSet_ico_ne_zero : dehnSet icoSet ≠ 0 := by
  rw [dehnSet_ico]
  exact edgeTerm_ne_zero (by norm_num) wordGamma_not_ratPi

