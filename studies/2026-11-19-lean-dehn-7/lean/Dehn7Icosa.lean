  Or.inl ⟨29, rfl, mem_segment_of_tight ico_ind_18_19_5
    (ico_tight 18 6 (by decide)) (ico_tight 18 7 (by decide))
    (ico_tight 19 6 (by decide)) (ico_tight 19 7 (by decide))
    (ico_tight 5 7 (by decide)) (ico_lt 5 6 (by decide))
    (ico_tight 4 6 (by decide)) (ico_lt 4 7 (by decide)) hx hi hj⟩

