lemma ico_cover_0_1 {x : R3} (hx : x ∈ sol icoN icoB) (hi : ⟪icoN 0, x⟫ = icoB 0)
    (hj : ⟪icoN 1, x⟫ = icoB 1) : icoCover x 0 1 :=
  Or.inr ⟨8, eq_of_tight ico_ind_0_1_8
    (ico_tight 8 8 (by decide)) (ico_tight 16 8 (by decide)) (ico_tight 0 8 (by decide))
    (ico_tight 1 8 (by decide)) (μ := ((1 / 2) + (1 / 2) * √5)) (a := ((1 / 2) + (1 / 2) * √5)) (a' := 1) (by s5pos)
    (by have ht := sqrt5_sq; ext t; fin_cases t <;> simp [icoN] <;> grind) hx hi hj⟩

lemma ico_cover_0_2 {x : R3} (hx : x ∈ sol icoN icoB) (hi : ⟪icoN 0, x⟫ = icoB 0)
    (hj : ⟪icoN 2, x⟫ = icoB 2) : icoCover x 0 2 :=
  Or.inr ⟨4, eq_of_tight ico_ind_0_2_12
    (ico_tight 12 4 (by decide)) (ico_tight 16 4 (by decide)) (ico_tight 0 4 (by decide))
    (ico_tight 2 4 (by decide)) (μ := (-(1 / 2) + (1 / 2) * √5)) (a := 1) (a' := (-(1 / 2) + (1 / 2) * √5)) (by s5pos)
    (by have ht := sqrt5_sq; ext t; fin_cases t <;> simp [icoN] <;> grind) hx hi hj⟩

lemma ico_cover_0_3 {x : R3} (hx : x ∈ sol icoN icoB) (hi : ⟪icoN 0, x⟫ = icoB 0)
    (hj : ⟪icoN 3, x⟫ = icoB 3) : icoCover x 0 3 :=
  (false_of_comb (i := 0) (j := 3) (c₁ := 16) (c₂ := 17) (c₃ := 0) (a := 1) (a' := 1)
    (μ₁ := (-(1 / 2) + (1 / 2) * √5)) (μ₂ := (-(1 / 2) + (1 / 2) * √5)) (μ₃ := 0) (by s5nn) (by s5nn) (by s5nn)
    (by have ht := sqrt5_sq; ext t; fin_cases t <;> simp [icoN] <;> grind)
    (by
      have ht := sqrt5_sq
      have e : 1 * icoB 0 + 1 * icoB 3 - ((-(1 / 2) + (1 / 2) * √5) * icoB 16 + (-(1 / 2) + (1 / 2) * √5) * icoB 17 +
          0 * icoB 0) = 8 := by simp [icoB]; grind
      have h1 := sqrt5_gt; have h2 := sqrt5_lt
      linarith)
    hx hi hj).elim

