/-- **γ = arccos(√5/3) is not a rational multiple of π.** -/
theorem wordGamma_not_ratPi : wordGamma ∉ ratPi := by
  intro hγ
  have h : ((1 : ℤ) : ℝ) * wordAlpha + ((2 : ℤ) : ℝ) * wordBeta ∈ ratPi := by
    have e : ((1 : ℤ) : ℝ) * wordAlpha + ((2 : ℤ) : ℝ) * wordBeta = wordGamma + π := by
      push_cast; linarith [wordGamma_eq]
    rw [e]; exact ratPi.add_mem hγ pi_mem_ratPi
  exact absurd (word_angles_int_indep 1 2 h).1 one_ne_zero

