cornerTet (apex D = (0,0,1))
  edge 01: length^2 = 1, angle = pi/2
  edge 02: length^2 = 1, angle = pi/2
  edge 03: length^2 = 1, angle = pi/2
  edge 12: length^2 = 2, angle = arccos(1/sqrt 3)
  edge 13: length^2 = 2, angle = arccos(1/sqrt 3)
  edge 23: length^2 = 2, angle = arccos(1/sqrt 3)
  6 * volume = 1;  altitude over ABC = 1.0
orthoTet  (apex D' = (0,1,1))
  edge 01: length^2 = 1, angle = pi/4
  edge 02: length^2 = 1, angle = pi/2
  edge 03: length^2 = 2, angle = pi/2
  edge 12: length^2 = 2, angle = pi/2
  edge 13: length^2 = 3, angle = pi/3
  edge 23: length^2 = 1, angle = pi/4
  6 * volume = 1;  altitude over ABC = 1.0
2*arccos(1/sqrt 3) - (pi - arccos(1/3)) = 0.0
