TITL YbCdMg-sample8-rCMY11s2-model4    ! title of up to 76 characters
    rCMY11s2-model4.res
    created by SHELXL-2016/6 at 14:44:47 on 10-Jul-2017
CELL 0.71073 15.7531 15.7531 15.7531 90 90 90    ! wavelength and unit-cell
ZERR 2 0.000046 0.000046 0.000046 0 0 0  ! Z (formula-units/cell), cellesd's
LATT 2
SYMM -x,-y,z                 ! symmetry operators (x,y,z must be left out)
SYMM -x,y,-z
SYMM x,-y,-z
SYMM z,x,y
SYMM z,-x,-y
SYMM -z,-x,y
SYMM -z,x,-y
SYMM y,z,x
SYMM -y,z,-x
SYMM y,-z,-x
SYMM -y,-z,x

SFAC     Cd     Mg  Yb             ! define scattering factor numbers
UNIT 113.50  31.41  24       ! unit cell contents in same order

FMAP 2                       ! Fo-Fc Fourier
PLAN -20                     ! printer plots and full analysis of peak list
DEFS 0.02 0.1 0.01 0.04

L.S. 300                      ! 300 cycles full-matrix least-squares
TEMP 22
ACTA                         ! CIF-output, bonds, Fourier, peak search
LIST4

EXYZ Cd3a Mg3a
