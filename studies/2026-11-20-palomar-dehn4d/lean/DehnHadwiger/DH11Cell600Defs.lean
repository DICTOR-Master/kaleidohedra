/-
Dehn–Hadwiger study, part 11: the regular 600-cell and whole-number checks on it (DICTO, 20 Nov 2026).

`cell600` is the polar of the regular 120-cell: its 600 facet normals are the 600 vertices of the 120-cell of radius
√8 in the standard coordinates, written in ℤ[φ] (pairs `(a, b)` for `a + b φ`, part 8's
`gval`), generated by sign changes and orderings (`orbit`). The list `cell600Z` repeats some vectors; the facets are
indexed by the vectors themselves (`{z // z ∈ cell600Z}`), so each counts once.

Exact checks, by `decide +kernel` on whole numbers, in part 12: the 600 distinct normals (`L600`), the 120 corners
(`V120_*`, each `(1/2) • gvec w`), and for every facet its four corners and four neighbouring facets (`recs600`).
Here: the order test `gnonneg` for ℤ[φ] and the equality test `veq`, with their soundness lemmas.
No `sorry`.
-/
import DehnHadwiger.DH10Ridge
import DehnHadwiger.DH8Cell120

open scoped RealInnerProductSpace
open Set MeasureTheory Measure Module TensorProduct DehnCanon

namespace DehnHadwiger

/-- The 24 orderings of four coordinates (coordinate `i` of the new vector is coordinate `σ i` of the old one);
the first 12 are the even ones. -/
def orders : List (Fin 4 → Fin 4) :=
  [![0, 1, 2, 3], ![0, 2, 3, 1], ![0, 3, 1, 2], ![1, 0, 3, 2], ![1, 2, 0, 3], ![1, 3, 2, 0], ![2, 0, 1, 3],
    ![2, 1, 3, 0], ![2, 3, 0, 1], ![3, 0, 2, 1], ![3, 1, 0, 2], ![3, 2, 1, 0], ![0, 1, 3, 2], ![0, 2, 1, 3],
    ![0, 3, 2, 1], ![1, 0, 2, 3], ![1, 2, 3, 0], ![1, 3, 0, 2], ![2, 0, 3, 1], ![2, 1, 0, 3], ![2, 3, 1, 0],
    ![3, 0, 1, 2], ![3, 1, 2, 0], ![3, 2, 0, 1]]

/-- All 16 sign changes of all orderings of `z` (`n = 24`), or of its even orderings only (`n = 12`). -/
def orbit (n : ℕ) (z : Fin 4 → ℤ × ℤ) : List (Fin 4 → ℤ × ℤ) :=
  (orders.take n).flatMap fun σ => (List.range 16).map fun s i => if s.testBit i then -z (σ i) else z (σ i)

/-- The 600 vertices of the regular 120-cell of radius √8 (the standard coordinates), as pairs
`(a, b) = a + b φ` (`gval`): all sign changes of all orderings of (0, 0, 2, 2), (1, 1, 1, √5), (φ⁻², φ, φ, φ) and
(φ⁻¹, φ⁻¹, φ⁻¹, φ²), and of the even orderings of (0, φ⁻², 1, φ²), (0, φ⁻¹, φ, √5) and (φ⁻¹, 1, φ, 2)
(√5 = 2φ − 1, φ⁻¹ = φ − 1, φ⁻² = 2 − φ, φ² = φ + 1). The list repeats some vectors. -/
def cell600Z : List (Fin 4 → ℤ × ℤ) :=
  orbit 24 ![(0, 0), (0, 0), (2, 0), (2, 0)] ++ orbit 24 ![(1, 0), (1, 0), (1, 0), (-1, 2)] ++
    orbit 24 ![(2, -1), (0, 1), (0, 1), (0, 1)] ++ orbit 24 ![(-1, 1), (-1, 1), (-1, 1), (1, 1)] ++
    orbit 12 ![(0, 0), (2, -1), (1, 0), (1, 1)] ++ orbit 12 ![(0, 0), (-1, 1), (0, 1), (-1, 2)] ++
    orbit 12 ![(-1, 1), (1, 0), (0, 1), (2, 0)]

/-- The regular 600-cell: `⟪n, x⟫ ≤ 1` for the 600 vertices `n` of the 120-cell (the 600-cell is its polar). -/
def cell600 : Set R4 := sol (fun z : {z // z ∈ cell600Z} => gvec z.1) (fun _ => 1)

instance : Finite {z // z ∈ cell600Z} := (List.finite_toSet cell600Z).to_subtype

/-! ### Whole-number tests and their soundness -/

/-- `a + b φ ≥ 0`, decided on whole numbers: with `u = 2a + b` it says `u + b √5 ≥ 0`. -/
def gnonneg (c : ℤ × ℤ) : Bool :=
  (0 ≤ 2 * c.1 + c.2 && 0 ≤ c.2) || (0 ≤ 2 * c.1 + c.2 && 5 * c.2 ^ 2 ≤ (2 * c.1 + c.2) ^ 2) ||
    (0 ≤ c.2 && (2 * c.1 + c.2) ^ 2 ≤ 5 * c.2 ^ 2)

lemma gval_eq (c : ℤ × ℤ) : gval c = ((2 * c.1 + c.2 : ℤ) + (c.2 : ℝ) * √5) / 2 := by
  unfold gval; rw [Real.goldenRatio]; push_cast; ring

lemma gnonneg_sound {c : ℤ × ℤ} (h : gnonneg c = true) : 0 ≤ gval c := by
  rw [gval_eq]
  have s5 : √5 * √5 = 5 := Real.mul_self_sqrt (by norm_num)
  have s0 : 0 ≤ √5 := Real.sqrt_nonneg 5
  set u : ℤ := 2 * c.1 + c.2 with hu
  set b : ℤ := c.2
  simp only [gnonneg, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq] at h
  rw [← hu] at h
  apply div_nonneg _ (by norm_num)
  rcases h with (⟨h1, h2⟩ | ⟨h1, h2⟩) | ⟨h1, h2⟩
  · have : (0 : ℝ) ≤ u := by exact_mod_cast h1
    have : (0 : ℝ) ≤ b := by exact_mod_cast h2
    positivity
  · have e1 : (0 : ℝ) ≤ u := by exact_mod_cast h1
    have e2 : 5 * (b : ℝ) ^ 2 ≤ (u : ℝ) ^ 2 := by exact_mod_cast h2
    by_contra hneg
    push Not at hneg
    nlinarith [sq_nonneg ((u : ℝ) - b * √5)]
  · have e1 : (0 : ℝ) ≤ b := by exact_mod_cast h1
    have e2 : (u : ℝ) ^ 2 ≤ 5 * (b : ℝ) ^ 2 := by exact_mod_cast h2
    by_contra hneg
    push Not at hneg
    have hA : 0 < -(u : ℝ) - b * √5 := by linarith
    have hB : 0 < -(u : ℝ) + b * √5 := by nlinarith [mul_nonneg e1 s0]
    nlinarith [mul_pos hA hB]

/-- Equality of two ℤ[φ] vectors, as a test. -/
def veq (z w : Fin 4 → ℤ × ℤ) : Bool := z 0 == w 0 && z 1 == w 1 && z 2 == w 2 && z 3 == w 3

lemma veq_sound {z w : Fin 4 → ℤ × ℤ} (h : veq z w = true) : z = w := by
  simp only [veq, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨h0, h1⟩, h2⟩, h3⟩ := h
  funext i; fin_cases i <;> assumption

lemma vmem_sound {z : Fin 4 → ℤ × ℤ} {L : List (Fin 4 → ℤ × ℤ)} (h : L.any (veq z) = true) : z ∈ L := by
  obtain ⟨w, hw, he⟩ := List.any_eq_true.1 h
  rw [veq_sound he]; exact hw

lemma gdot_comm (z w : Fin 4 → ℤ × ℤ) : gdot z w = gdot w z := by
  unfold gdot gmul; ext <;> simp <;> ring

lemma inner_half_gvec (z w : Fin 4 → ℤ × ℤ) : ⟪gvec z, (1 / 2 : ℝ) • gvec w⟫ = gval (gdot z w) / 2 := by
  rw [inner_smul_right, inner_gvec]; ring

end DehnHadwiger
