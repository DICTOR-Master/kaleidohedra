lemma tne (F : Facts y) : Ex.ev (V y) W_t ≠ 0 := by
  show y.b 0 / y.w 0 ≠ 0
  exact (div_pos (b0pos F) (F.wp 0)).ne'

theorem fs_G (F : Facts y) (hE : Ex.ev (V y) E_G = 0) : Fs_G.eval (V y 0) (V y 1) (V y 2) = 0 := by
  have I := invs F
  have h0 := num_zero T (V y) (V y 0) (V y 1) (V y 2) 27 I E_G finb_G hE
  have h1 := ZP.eq_of_eqv fin_G (V y 0) (V y 1) (V y 2)
  simp only [ZP.eval_mul, ZP.eval_const, ZP.eval_prod, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
    ZP.eval_pow, h0, mul_zero] at h1
  have hp : (1 : ℝ) ≠ 0 := one_ne_zero
  have : (1 : ℝ) * (Fs_G.eval (V y 0) (V y 1) (V y 2) * ((1 : ℝ))) = 0 := by
    push_cast at h1 ⊢; linarith
  rcases mul_eq_zero.mp this with h | h
  · norm_num at h
  rcases mul_eq_zero.mp h with h | h
  · exact h
  · exact absurd h hp

theorem fs_H1 (F : Facts y) (hE : Ex.ev (V y) E_H1 = 0) : Fs_H1.eval (V y 0) (V y 1) (V y 2) = 0 := by
  have I := invs F
  have h0 := num_zero T (V y) (V y 0) (V y 1) (V y 2) 27 I E_H1 finb_H1 hE
  have h1 := ZP.eq_of_eqv fin_H1 (V y 0) (V y 1) (V y 2)
  simp only [ZP.eval_mul, ZP.eval_const, ZP.eval_prod, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
    ZP.eval_pow, h0, mul_zero] at h1
  have g0 : gH1_0.eval (V y 0) (V y 1) (V y 2) ≠ 0 := by
    have w := ZP.eq_of_eqv witH1_0 (V y 0) (V y 1) (V y 2)
    obtain ⟨s1, s2⟩ := frac_sound T (V y) (V y 0) (V y 1) (V y 2) 27 I W_onepu2 witbH1_0
    rw [ZP.eval_mul] at w
    intro hg
    rw [hg, zero_mul, ← s1] at w
    exact absurd w (mul_ne_zero (show Ex.ev (V y) W_onepu2 ≠ 0 from dne3 F) s2)
  have g1 : gH1_1.eval (V y 0) (V y 1) (V y 2) ≠ 0 := by
    have w := ZP.eq_of_eqv witH1_1 (V y 0) (V y 1) (V y 2)
    obtain ⟨s1, s2⟩ := frac_sound T (V y) (V y 0) (V y 1) (V y 2) 27 I W_k4pk8 witbH1_1
    rw [ZP.eval_mul] at w
    intro hg
    rw [hg, zero_mul, ← s1] at w
    exact absurd w (mul_ne_zero (show Ex.ev (V y) W_k4pk8 ≠ 0 from dne18 F) s2)
  have hp : gH1_0.eval (V y 0) (V y 1) (V y 2) ^ 1 * (gH1_1.eval (V y 0) (V y 1) (V y 2) ^ 1 * 1) ≠ 0 := mul_ne_zero (pow_ne_zero _ g0) (mul_ne_zero (pow_ne_zero _ g1) (one_ne_zero))
  have : (1 : ℝ) * (Fs_H1.eval (V y 0) (V y 1) (V y 2) * (gH1_0.eval (V y 0) (V y 1) (V y 2) ^ 1 * (gH1_1.eval (V y 0) (V y 1) (V y 2) ^ 1 * 1))) = 0 := by
    push_cast at h1 ⊢; linarith
  rcases mul_eq_zero.mp this with h | h
  · norm_num at h
  rcases mul_eq_zero.mp h with h | h
  · exact h
  · exact absurd h hp

