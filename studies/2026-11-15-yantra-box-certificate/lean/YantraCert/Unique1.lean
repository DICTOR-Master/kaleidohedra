theorem fm_G (F : Facts y) : Fm_G.eval (V y 0) (tau y) (rho y) = 0 := by
  have h := ZP.eq_of_eqv pull_G (V y 0) (tau y) (rho y)
  rw [ZP.eval_mul, ZP.eval_const, subst_pt F _ _ zd_G, fs_G F (eG F)] at h
  simp only [ZP.eval_mul, ZP.eval_const, ZP.eval_prod, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, ZP.eval_pow] at h
  have p0 : 0 < pfG_0.eval (V y 0) (tau y) (rho y) ^ 2 := by
    apply pow_pos; simp [pfG_0, ZP.eval]; linarith [u_lt1 F]
  have p1 : 0 < pfG_1.eval (V y 0) (tau y) (rho y) ^ 2 := by
    apply pow_pos; simp [pfG_1, ZP.eval]; linarith [u_pos F]
  have p2 : 0 < pfG_2.eval (V y 0) (tau y) (rho y) ^ 2 := by
    apply pow_pos; simp [pfG_2, ZP.eval]; positivity
  have hp : 0 < pfG_0.eval (V y 0) (tau y) (rho y) ^ 2 * (pfG_1.eval (V y 0) (tau y) (rho y) ^ 2 * (pfG_2.eval (V y 0) (tau y) (rho y) ^ 2 * 1)) := mul_pos p0 (mul_pos p1 (mul_pos p2 (one_pos)))
  have : (1 : ℝ) * (Fm_G.eval (V y 0) (tau y) (rho y) * (pfG_0.eval (V y 0) (tau y) (rho y) ^ 2 * (pfG_1.eval (V y 0) (tau y) (rho y) ^ 2 * (pfG_2.eval (V y 0) (tau y) (rho y) ^ 2 * 1)))) = 0 := by push_cast at h ⊢; linarith
  rcases mul_eq_zero.mp this with h | h
  · norm_num at h
  rcases mul_eq_zero.mp h with h | h
  · exact h
  · exact absurd h hp.ne'

