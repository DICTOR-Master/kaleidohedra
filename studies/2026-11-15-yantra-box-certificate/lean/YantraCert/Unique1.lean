theorem invs (F : Facts y) : ∀ i < 27, Inv T (V y) (V y 0) (V y 1) (V y 2) i := by
  have I0 : Inv T (V y) (V y 0) (V y 1) (V y 2) 0 := by
    have e : nth (ZP.nil, ZP.one) T 0 = (N0, D0) := rfl
    unfold Inv; rw [e]; simp [N0, D0, ZP.eval]
  have I1 : Inv T (V y) (V y 0) (V y 1) (V y 2) 1 := by
    have e : nth (ZP.nil, ZP.one) T 1 = (N1, D1) := rfl
    unfold Inv; rw [e]; simp [N1, D1, ZP.eval]
  have I2 : Inv T (V y) (V y 0) (V y 1) (V y 2) 2 := by
    have e : nth (ZP.nil, ZP.one) T 2 = (N2, D2) := rfl
    unfold Inv; rw [e]; simp [N2, D2, ZP.eval]
  have I3 := step_inv T (V y) (V y 0) (V y 1) (V y 2) 3 d3 n3 K3 step3
    (fun j hj => by interval_cases j <;> assumption) (gstep3 F) (dne3 F)
  have I4 := step_inv T (V y) (V y 0) (V y 1) (V y 2) 4 d4 n4 K4 step4
