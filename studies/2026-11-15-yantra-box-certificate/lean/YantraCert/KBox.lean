module

public import YantraCert.KBoxData

@[expose] public section

/-!
# The Krawczyk box: exactly one zero of `F~ = (G~, H~, D~)` in the hole `X`

`kbox_exists_unique`: there is exactly one `x` in the box `X` (the certificate's hole `Krawczyk`, half-width `2^-22` around
Theorem 10's solution) with `G~(x) = H~(x) = D~(x) = 0`.  Uniqueness is Krawczyk's contraction test on `X`
(R. Krawczyk 1969; R. E. Moore 1977; A. Neumaier 1990, Thm 5.1.7; slopes after R. Krawczyk and A. Neumaier 1985); existence is
Banach's fixed-point theorem (Mathlib `ContractingWith.fixedPoint`) on the small box `Xs` (half-width `2^-100`) inside `X`.
All numbers are those of `KBoxData` (generated by `scripts/c2_kbox_lean.py`); the corner sums there are evaluated by the kernel.
-/

namespace YantraCert.KBox
open YantraCert Finset

set_option maxHeartbeats 8000000

lemma P0_dims : P0.Dx = 8 ∧ P0.Dy = 0 ∧ P0.Dz = 2 := ⟨rfl, rfl, rfl⟩
lemma P1_dims : P1.Dx = 26 ∧ P1.Dy = 10 ∧ P1.Dz = 3 := ⟨rfl, rfl, rfl⟩
lemma P2_dims : P2.Dx = 26 ∧ P2.Dy = 10 ∧ P2.Dz = 2 := ⟨rfl, rfl, rfl⟩

lemma deg (k : Fin 3) : (Fv k).degOK = true := by
  fin_cases k
  · exact P_deg.1
  · exact P_deg.2.1
  · exact P_deg.2.2

/-- the slopes of the system -/
noncomputable def S (k j : Fin 3) (x m : Fin 3 → ℝ) : ℝ := (Fv k).slope j x m

lemma hS (c r : Fin 3 → ℝ) : ∀ x m, InBox c r x → InBox c r m → ∀ k, F k x - F k m = ∑ j, S k j x m * (x j - m j) :=
  fun x m _ _ k => (Fv k).slope_identity x m

lemma inb {Q : Nat} {L H : Fin 3 → Nat} {x : Fin 3 → ℝ}
    (hx : InBox (fun j => ((L j : ℝ) / Q + (H j : ℝ) / Q) / 2) (fun j => ((H j : ℝ) / Q - (L j : ℝ) / Q) / 2) x) :
    ∀ j, (L j : ℝ) / Q ≤ x j ∧ x j ≤ (H j : ℝ) / Q := by
  intro j; have := hx j; rw [abs_le] at this; constructor <;> linarith [this.1, this.2]

