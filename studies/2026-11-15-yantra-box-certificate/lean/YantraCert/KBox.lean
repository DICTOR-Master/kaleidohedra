theorem hhS : ∀ k j, (Fv k).sCorner QS j true HS - (Fv k).sCorner QS j false LS = hiS k j := by
  intro k j; fin_cases k <;> fin_cases j
  exacts [hS_00, hS_01, hS_02, hS_10, hS_11, hS_12, hS_20, hS_21, hS_22]

/-! ## Box X: at most one zero -/

lemma hSbX : ∀ x m, InBox cX rX x → InBox cX rX m → ∀ k j, loX k j ≤ S k j x m ∧ S k j x m ≤ hiX k j := by
  intro x m hx hm k j
  have b := (Fv k).slope_bounds (deg k) QX (by decide) LX HX x m (inb hx) (inb hm) j
  rw [hlX k j, hhX k j] at b; exact b

lemma cX_in : InBox cX rX cX := fun j => by
  simp only [sub_self, abs_zero, rX]
  fin_cases j <;> simp [LX, HX, QX] <;> norm_num

lemma hlhX : ∀ k j, loX k j ≤ hiX k j := fun k j =>
  (hSbX cX cX cX_in cX_in k j).1.trans (hSbX cX cX cX_in cX_in k j).2

lemma hMX : ∀ i j, |(if i = j then (1 : ℝ) else 0) - ∑ k, YX i k * ((loX k j + hiX k j) / 2)| +
    ∑ k, |YX i k| * ((hiX k j - loX k j) / 2) ≤ MX i j := by
  intro i j
  fin_cases i <;> fin_cases j <;> simp [Fin.sum_univ_three, YX, loX, hiX, MX] <;> norm_num [abs_of_nonneg, abs_of_neg]

lemma hrX : ∀ i, 0 < rX i := by intro i; fin_cases i <;> simp [rX, LX, HX, QX] <;> norm_num

lemma hCX : ∀ i, ∑ j, MX i j * rX j < rX i := by
  intro i; fin_cases i <;> simp [Fin.sum_univ_three, MX, rX, LX, HX, QX] <;> norm_num

/-- **uniqueness**: at most one zero of `F~` in `X` -/
theorem unique_X (x x' : Fin 3 → ℝ) (hx : InBox cX rX x) (hx' : InBox cX rX x') (h0 : ∀ k, F k x = 0)
    (h0' : ∀ k, F k x' = 0) : x = x' :=
  krawczyk_unique F S cX rX loX hiX YX MX (hS cX rX) hSbX hlhX hMX hrX hCX x x' hx hx' h0 h0'

/-! ## Box Xs: a zero exists -/

lemma hSbS : ∀ x m, InBox cS rS x → InBox cS rS m → ∀ k j, loS k j ≤ S k j x m ∧ S k j x m ≤ hiS k j := by
  intro x m hx hm k j
  have b := (Fv k).slope_bounds (deg k) QS (by decide) LS HS x m (inb hx) (inb hm) j
  rw [hlS k j, hhS k j] at b; exact b

lemma cS_in : InBox cS rS cS := fun j => by
  simp only [sub_self, abs_zero, rS]
  fin_cases j <;> simp [LS, HS, QS] <;> norm_num

lemma hlhS : ∀ k j, loS k j ≤ hiS k j := fun k j =>
  (hSbS cS cS cS_in cS_in k j).1.trans (hSbS cS cS cS_in cS_in k j).2

lemma hMS : ∀ i j, |(if i = j then (1 : ℝ) else 0) - ∑ k, YS i k * ((loS k j + hiS k j) / 2)| +
    ∑ k, |YS i k| * ((hiS k j - loS k j) / 2) ≤ MS i j := by
  intro i j
  fin_cases i <;> fin_cases j <;> simp [Fin.sum_univ_three, YS, loS, hiS, MS] <;> norm_num [abs_of_nonneg, abs_of_neg]

lemma hrS : ∀ i, 0 < rS i := by intro i; fin_cases i <;> simp [rS, LS, HS, QS] <;> norm_num

lemma hKS : ∀ i, ∑ j, MS i j * rS j ≤ KS * rS i := by
  intro i; fin_cases i <;> simp [Fin.sum_univ_three, MS, rS, LS, HS, QS, KS] <;> norm_num

lemma cS_eq (j : Fin 3) : cS j = ((LS j + HS j : Nat) : ℝ) / ((2 * QS : Nat) : ℝ) := by
  simp only [cS]; push_cast; field_simp

lemma FcS_0 : F 0 cS = FcS 0 := by
  simp only [F]
  rw [cS_eq 0, cS_eq 1, cS_eq 2, (Fv 0).vq_eval (deg 0) (2 * QS) (by decide) (fun j => LS j + HS j)]
  simp only [Fv, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
  rw [vS_0_pp, vS_0_pn, P0_dims.1, P0_dims.2.1, P0_dims.2.2]
  simp only [FcS, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, QS]
  norm_num

lemma FcS_1 : F 1 cS = FcS 1 := by
  simp only [F]
  rw [cS_eq 0, cS_eq 1, cS_eq 2, (Fv 1).vq_eval (deg 1) (2 * QS) (by decide) (fun j => LS j + HS j)]
  simp only [Fv, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
  rw [vS_1_pp, vS_1_pn, P1_dims.1, P1_dims.2.1, P1_dims.2.2]
  simp only [FcS, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, QS]
  norm_num

lemma FcS_2 : F 2 cS = FcS 2 := by
  simp only [F]
  rw [cS_eq 0, cS_eq 1, cS_eq 2, (Fv 2).vq_eval (deg 2) (2 * QS) (by decide) (fun j => LS j + HS j)]
  simp only [Fv, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
  rw [vS_2_pp, vS_2_pn, P2_dims.1, P2_dims.2.1, P2_dims.2.2]
  simp only [FcS, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, QS]
  norm_num

lemma FcS_eq (k : Fin 3) : F k cS = FcS k := by
  fin_cases k
  exacts [FcS_0, FcS_1, FcS_2]

lemma hIS : ∀ i, |∑ k, YS i k * F k cS| + ∑ j, MS i j * rS j ≤ rS i := by
  intro i
  simp only [FcS_eq]
  fin_cases i <;> simp [Fin.sum_univ_three, YS, FcS, MS, rS, LS, HS, QS] <;> norm_num [abs_of_nonneg, abs_of_neg]

lemma hZS : ∀ i l, ∑ k, ZS i k * YS k l = if i = l then 1 else 0 := by
  intro i l; fin_cases i <;> fin_cases l <;> simp [Fin.sum_univ_three, ZS, YS] <;> norm_num

/-- **existence**: a zero of `F~` in `Xs` -/
theorem exists_S : ∃ x, InBox cS rS x ∧ ∀ k, F k x = 0 :=
  krawczyk_exists F S cS rS loS hiS YS ZS MS KS (hS cS rS) hSbS hlhS hMS hrS (by norm_num [KS])
    (by norm_num [KS]) hKS hIS hZS

lemma S_sub_X (x : Fin 3 → ℝ) (hx : InBox cS rS x) : InBox cX rX x := by
  have b := inb hx
  intro j
  rw [abs_le]
  have := b j
  fin_cases j <;> simp only [cX, rX] at this ⊢ <;> simp [LX, HX, QX, LS, HS, QS] at this ⊢ <;> constructor <;> linarith

/-- **the Krawczyk box holds exactly one zero of `F~ = (G~, H~, D~)`** -/
theorem kbox_exists_unique : ∃! x : Fin 3 → ℝ, InBox cX rX x ∧ ∀ k, F k x = 0 := by
  obtain ⟨x, hx, h0⟩ := exists_S
  exact ⟨x, ⟨S_sub_X x hx, h0⟩, fun y hy => unique_X y x hy.1 (S_sub_X x hx) hy.2 h0⟩

end YantraCert.KBox
