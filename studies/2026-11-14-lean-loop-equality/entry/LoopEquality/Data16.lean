def zqOf (b : ZMod 3) : List ((ℤ × ℤ) × (ℤ × ℤ) × (ℤ × ℤ) × (ℤ × ℤ)) :=
  if b = 1 then zq1 else if b = 2 then zq2 else []

theorem zqOf_0 : zqOf 0 = [] := rfl
theorem zqOf_1 : zqOf 1 = zq1 := rfl
theorem zqOf_2 : zqOf 2 = zq2 := rfl

def sigR (a : ZMod 3) (j : ℤ) : ZMod 3 := if j = -1 then a else 0
def sigF (b : ZMod 3) (j : ℤ) : ZMod 3 := if j = 1 then b else 0

def Zf (L : List ((ℤ × ℤ) × (ℤ × ℤ) × (ℤ × ℤ) × (ℤ × ℤ))) : Finset (Finset (ℤ × ℤ)) := (L.map toSet).toFinset

def okQ (b : ZMod 3) (q : (ℤ × ℤ) × (ℤ × ℤ) × (ℤ × ℤ) × (ℤ × ℤ)) : Bool :=
  decide (nrm (toSet q) ∈ Zf (zqOf b)) && decide (nrm (gP (0, 0) (toSet q)) ∈ Zf (zqOf b))

def l1sF (b : ZMod 3) (i : ℕ) : List (List Atom) := (ext (sigF b) 0 i [upA 0 (0, 0)]).filter (headEnd 0)

/-- One piece of the completeness check: every meeting pair whose second arc starts at `f`. -/
def pieceF (b : ZMod 3) (i : ℕ) (f : ℤ × ℤ) : Bool :=
  (l1sF b i).all (fun l₁ => ((ext (sigF b) 0 (6 - i) [upA 0 f]).filter (headEnd 0)).all (fun l₂ =>
    disjB l₁ l₂ || !dist4B (headPos l₁, (0, 0), headPos l₂, f) || okQ b (headPos l₁, (0, 0), headPos l₂, f)))

theorem check_of_pieces (b : ZMod 3) (h : ∀ i ∈ [2, 4], ∀ f ∈ boxPts (0, 0), pieceF b i f = true) :
    ∀ q ∈ candQuads (sigF b) 0 (0, 0), nrm (toSet q) ∈ Zf (zqOf b) ∧ nrm (gP (0, 0) (toSet q)) ∈ Zf (zqOf b) := by
  intro q hq
  unfold candQuads at hq
  obtain ⟨hq, hd⟩ := List.mem_filter.mp hq
  obtain ⟨i, hi, hq⟩ := List.mem_flatMap.mp hq
  obtain ⟨l₁, hl₁, hq⟩ := List.mem_flatMap.mp hq
  obtain ⟨f, hf, hq⟩ := List.mem_flatMap.mp hq
  obtain ⟨l₂, hl₂, rfl⟩ := List.mem_map.mp hq
  obtain ⟨hl₂, hm⟩ := List.mem_filter.mp hl₂
  have hp := h i hi f hf
  unfold pieceF at hp
  rw [List.all_eq_true] at hp
  have hp := hp l₁ hl₁
  rw [List.all_eq_true] at hp
  have hp := hp l₂ hl₂
  simp only [Bool.not_eq_eq_eq_not, Bool.not_true] at hm
  rw [hm, Bool.false_or, hd, Bool.not_true, Bool.false_or] at hp
  unfold okQ at hp
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hp
  exact hp

def propsB (b : ZMod 3) : Bool :=
  decide (((zqOf b).map toSet).Nodup) && (zqOf b).all (fun q => dist4B q &&
    (q.1.1 % 3 == 0 && q.1.2 % 3 == 0 && q.2.1.1 % 3 == 0 && q.2.1.2 % 3 == 0 && q.2.2.1.1 % 3 == 0 &&
      q.2.2.1.2 % 3 == 0 && q.2.2.2.1 % 3 == 0 && q.2.2.2.2 % 3 == 0) && decide (nrm (toSet q) = toSet q))

def S16B (a b : ZMod 3) (v : Atom) : ℤ :=
  ((zqOf b).map (fun q => shapeVal4B (sigR a) (sigF b) 0 (0, 0) v q.1 q.2.1 q.2.2.1 q.2.2.2)).sum

set_option maxRecDepth 100000 in
theorem zq_props : ∀ b : ZMod 3, propsB b = true := by decide +kernel

