lemma oct_cover {x : R3} (hx : x ∈ sol octN (octB)) (i j : Fin 8) (hij : i ≠ j)
    (hi : ⟪octN i, x⟫ = octB i) (hj : ⟪octN j, x⟫ = octB j) : octCover x i j := by
  rcases lt_or_gt_of_ne hij with h | h
  · exact oct_cover_lt hx i j h hi hj
  · rcases oct_cover_lt hx j i h hj hi with ⟨e, he, hseg⟩ | hk
    · exact Or.inl ⟨e, (Set.pair_comm i j).trans he, hseg⟩
    · exact Or.inr hk

/-- **The octahedron** |x| + |y| + |z| ≤ 1, as its eight face half-spaces. -/
def octSet : Set R3 := sol octN octB

theorem oct_bounded : Bornology.IsBounded (sol octN octB) := by
  refine bounded_of_coords 1 (fun x hx i => ?_)
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩ := oct_ineqs hx
  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] <;> rw [abs_le] <;>
    constructor <;> linarith

theorem isPoly_oct : IsPoly octSet := ⟨oct_bounded, Fin 8, inferInstance, octN, _, rfl⟩

/-- **The corners, faces and edges of the octahedron satisfy `IsEdgeData`.** -/
theorem oct_isEdgeData : IsEdgeData octN octB octP octFi octFj octVk octVl where
  bounded := oct_bounded
  corner_mem := fun k m => oct_le m k
  corner_three := fun k => by
    obtain ⟨h1, h2, h3, t1, t2, t3⟩ := octT_spec k
    exact ⟨_, _, _, h1, h2, h3, oct_tight _ _ t1, oct_tight _ _ t2, oct_tight _ _ t3⟩
  faces_ne := fun e => (octE_lt e).ne
  faces_inj := fun e e' h => by
    rcases Set.pair_eq_pair_iff.1 h with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact octE_inj e e' h1 h2
    · have a := octE_lt e
      rw [h1, h2] at a
      exact absurd a (lt_asymm (octE_lt e'))
  tight := fun e => by
    obtain ⟨t1, t2, t3, t4⟩ := octE_tight e
    exact ⟨oct_tight _ _ t1, oct_tight _ _ t2, oct_tight _ _ t3, oct_tight _ _ t4⟩
  other := fun e m h1 h2 => by
    rcases octE_other e m h1 h2 with h | h
    · exact Or.inl (oct_lt _ _ h)
    · exact Or.inr (oct_lt _ _ h)
  cover := fun x hx i j hij hi hj => oct_cover hx i j hij hi hj

/-- The edges of the octahedron all have length √2 … -/
lemma oct_dist (e : Fin 12) : dist (octP (octVk e)) (octP (octVl e)) = √2 := by
  have h2 : (√2 : ℝ) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  apply dist3 _ _ (Real.sqrt_nonneg 2)
  rw [h2]
  fin_cases e <;> simp [octP, octVk, octVl] <;> norm_num

/-- … and all meet at the angle π − arccos(1/3). -/
lemma oct_theta (e : Fin 12) :
    theta (cone octN ({octFi e, octFj e} : Set (Fin 8))) =
      (Submodule.Quotient.mk (π - tetDihedral) : Angle) := by
  have key : ∀ i j : Fin 8, ⟪octN i, octN i⟫ = 3 → ⟪octN j, octN j⟫ = 3 → ⟪octN i, octN j⟫ = -(-1) →
      theta (cone octN ({i, j} : Set (Fin 8))) = (Submodule.Quotient.mk (π - tetDihedral) : Angle) := by
    intro i j hii hjj hij
    rw [theta_pair_of_gram octN rfl (by norm_num) hii hjj hij (by norm_num), Real.sqrt_mul_self (by norm_num),
      arccos_neg_third]
  fin_cases e <;> apply key <;> simp [octN, octFi, octFj, inner3, norm3_sq] <;> norm_num

/-- **The Dehn invariant of the octahedron**: (−12√2) ⊗ arccos(1/3). -/
theorem dehnSet_oct : dehnSet octSet = edgeTerm (-12 * √2) tetDihedral := by
  unfold octSet
  rw [oct_isEdgeData.dehnSet_eq]
  have h : ∀ e : Fin 12, dist (octP (octVk e)) (octP (octVl e)) ⊗ₜ[ℚ]
      theta (cone octN ({octFi e, octFj e} : Set (Fin 8))) = -edgeTerm √2 tetDihedral := by
    intro e
    rw [oct_dist, oct_theta, ← edgeTerm_pi_sub]; rfl
  rw [Finset.sum_congr rfl (fun e _ => h e), Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    show (-12 * √2 : ℝ) = ((-12 : ℤ) : ℝ) * √2 by push_cast; ring, edgeTerm_int1]
  abel

/-- **The octahedron is a nonzero word.** -/
theorem dehnSet_oct_ne_zero : dehnSet octSet ≠ 0 := by
  rw [dehnSet_oct]
  exact edgeTerm_ne_zero (by positivity) tetDihedral_not_ratPi

