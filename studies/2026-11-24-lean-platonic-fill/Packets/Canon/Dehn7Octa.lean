lemma oct_cover_0_1 {x : R3} (hx : x ∈ sol octN (octB)) (hi : ⟪octN 0, x⟫ = octB 0)
    (hj : ⟪octN 1, x⟫ = octB 1) : octCover x 0 1 :=
  Or.inl ⟨0, rfl, mem_segment_of_tight oct_ind_0_1_4
    (oct_tight 0 0 (by decide)) (oct_tight 0 2 (by decide))
    (oct_tight 1 0 (by decide)) (oct_tight 1 2 (by decide))
    (oct_tight 4 2 (by decide)) (oct_lt 4 0 (by decide))
    (oct_tight 2 0 (by decide)) (oct_lt 2 2 (by decide)) hx hi hj⟩

lemma oct_cover_0_2 {x : R3} (hx : x ∈ sol octN (octB)) (hi : ⟪octN 0, x⟫ = octB 0)
    (hj : ⟪octN 2, x⟫ = octB 2) : octCover x 0 2 :=
  Or.inl ⟨1, rfl, mem_segment_of_tight oct_ind_0_2_4
    (oct_tight 0 0 (by decide)) (oct_tight 0 4 (by decide))
    (oct_tight 2 0 (by decide)) (oct_tight 2 4 (by decide))
    (oct_tight 4 4 (by decide)) (oct_lt 4 0 (by decide))
    (oct_tight 1 0 (by decide)) (oct_lt 1 4 (by decide)) hx hi hj⟩

lemma oct_cover_0_3 {x : R3} (hx : x ∈ sol octN (octB)) (hi : ⟪octN 0, x⟫ = octB 0)
    (hj : ⟪octN 3, x⟫ = octB 3) : octCover x 0 3 := by
  have H := oct_ineqs hx
  simp [octN, octB, inner3] at hi hj
  refine Or.inr ⟨0, ?_⟩
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩ := H
  ext r; fin_cases r <;> simp [octP] <;> linarith

lemma oct_cover_0_4 {x : R3} (hx : x ∈ sol octN (octB)) (hi : ⟪octN 0, x⟫ = octB 0)
    (hj : ⟪octN 4, x⟫ = octB 4) : octCover x 0 4 :=
  Or.inl ⟨2, rfl, mem_segment_of_tight oct_ind_0_4_2
    (oct_tight 0 2 (by decide)) (oct_tight 0 4 (by decide))
    (oct_tight 4 2 (by decide)) (oct_tight 4 4 (by decide))
    (oct_tight 2 4 (by decide)) (oct_lt 2 2 (by decide))
    (oct_tight 1 2 (by decide)) (oct_lt 1 4 (by decide)) hx hi hj⟩

