lemma oct_cover_1_2 {x : R3} (hx : x ∈ sol octN (octB)) (hi : ⟪octN 1, x⟫ = octB 1)
    (hj : ⟪octN 2, x⟫ = octB 2) : octCover x 1 2 := by
  have H := oct_ineqs hx
