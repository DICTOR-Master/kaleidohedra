lemma dod_cover {x : R3} (hx : x ∈ sol dodN dodB) (i j : Fin 12) (hij : i ≠ j)
    (hi : ⟪dodN i, x⟫ = dodB i) (hj : ⟪dodN j, x⟫ = dodB j) : dodCover x i j := by
  rcases lt_or_gt_of_ne hij with h | h
  · exact dod_cover_lt hx i j h hi hj
  · rcases dod_cover_lt hx j i h hj hi with ⟨e, he, hseg⟩ | hk
    · exact Or.inl ⟨e, (Set.pair_comm i j).trans he, hseg⟩
    · exact Or.inr hk

/-- **The regular dodecahedron**, as its twelve face half-spaces (normals along the corners of an icosahedron). -/
def dodSet : Set R3 := sol dodN dodB

theorem dod_bounded : Bornology.IsBounded (sol dodN dodB) := by
  refine bounded_of_coords 6 (fun x hx i => ?_)
  have h1 := sqrt5_gt; have h2 := sqrt5_lt
  obtain ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11⟩ := dod_ineqs hx
  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] <;> rw [abs_le] <;>
    constructor <;> linarith

theorem isPoly_dod : IsPoly dodSet := ⟨dod_bounded, Fin 12, inferInstance, dodN, _, rfl⟩

/-- **The corners, faces and edges of the dodecahedron satisfy `IsEdgeData`.** -/
theorem dod_isEdgeData : IsEdgeData dodN dodB dodP dodFi dodFj dodVk dodVl where
  bounded := dod_bounded
  corner_mem := fun k m => dod_le m k
  corner_three := fun k => by
    obtain ⟨h1, h2, h3, t1, t2, t3⟩ := dodT_spec k
    exact ⟨_, _, _, h1, h2, h3, dod_tight _ _ t1, dod_tight _ _ t2, dod_tight _ _ t3⟩
  faces_ne := fun e => (dodE_lt e).ne
  faces_inj := fun e e' h => by
    rcases Set.pair_eq_pair_iff.1 h with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact dodE_inj e e' h1 h2
    · have a := dodE_lt e
      rw [h1, h2] at a
      exact absurd a (lt_asymm (dodE_lt e'))
  tight := fun e => by
    obtain ⟨t1, t2, t3, t4⟩ := dodE_tight e
    exact ⟨dod_tight _ _ t1, dod_tight _ _ t2, dod_tight _ _ t3, dod_tight _ _ t4⟩
  other := fun e m h1 h2 => by
    rcases dodE_other e m h1 h2 with h | h
    · exact Or.inl (dod_lt _ _ h)
    · exact Or.inr (dod_lt _ _ h)
  cover := fun x hx i j hij hi hj => dod_cover hx i j hij hi hj

/-- The edges of the dodecahedron all have length 2√5 − 2 … -/
lemma dod_dist (e : Fin 30) : dist (dodP (dodVk e)) (dodP (dodVl e)) = 2 * √5 - 2 := by
  have ht := sqrt5_sq
  apply dist3 _ _ (by s5nn)
  fin_cases e <;> simp [dodP, dodVk, dodVl] <;> grind

/-- … and all meet at the angle arccos(−1/√5) = π − α. -/
lemma dod_theta (e : Fin 30) :
    theta (cone dodN ({dodFi e, dodFj e} : Set (Fin 12))) =
      (Submodule.Quotient.mk (π - wordAlpha) : Angle) := by
  have ht := sqrt5_sq
  have hX : (0 : ℝ) < 10 + 2 * √5 := by positivity
  have key : ∀ i j : Fin 12, ⟪dodN i, dodN i⟫ = 10 + 2 * √5 → ⟪dodN j, dodN j⟫ = 10 + 2 * √5 →
      ⟪dodN i, dodN j⟫ = -(-(2 + 2 * √5)) →
      theta (cone dodN ({i, j} : Set (Fin 12))) = (Submodule.Quotient.mk (π - wordAlpha) : Angle) := by
    intro i j hii hjj hij
    have hne : (10 + 2 * √5) * (10 + 2 * √5) ≠ (-(2 + 2 * √5)) ^ 2 := by
      intro h
      have h' : (96 : ℝ) + 32 * √5 = 0 := by linear_combination h
      linarith [sqrt5_gt]
    have hq : (2 + 2 * √5) / (10 + 2 * √5) = √5 / 5 := by
      rw [div_eq_div_iff hX.ne' (by norm_num)]; linear_combination (-2 : ℝ) * ht
    rw [theta_pair_of_gram dodN rfl hX hii hjj hij hne, Real.sqrt_mul_self hX.le, neg_div, hq,
      Real.arccos_neg]
    rfl
  fin_cases e <;> apply key <;> simp [dodN, dodFi, dodFj, inner3, norm3_sq] <;> grind

/-- **The Dehn invariant of the dodecahedron**: (−30 (2√5 − 2)) ⊗ α. -/
theorem dehnSet_dod : dehnSet dodSet = edgeTerm (-30 * (2 * √5 - 2)) wordAlpha := by
  unfold dodSet
  rw [dod_isEdgeData.dehnSet_eq]
  have h : ∀ e : Fin 30, dist (dodP (dodVk e)) (dodP (dodVl e)) ⊗ₜ[ℚ]
      theta (cone dodN ({dodFi e, dodFj e} : Set (Fin 12))) = -edgeTerm (2 * √5 - 2) wordAlpha := by
    intro e
    rw [dod_dist, dod_theta, ← edgeTerm_pi_sub]; rfl
  rw [Finset.sum_congr rfl (fun e _ => h e), Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    show (-30 * (2 * √5 - 2) : ℝ) = ((-30 : ℤ) : ℝ) * (2 * √5 - 2) by push_cast; ring, edgeTerm_int1]
  abel

/-- **The dodecahedron is a nonzero word.** -/
theorem dehnSet_dod_ne_zero : dehnSet dodSet ≠ 0 := by
  rw [dehnSet_dod]
  refine edgeTerm_ne_zero ?_ wordAlpha_not_ratPi
  have := sqrt5_gt
  intro h; nlinarith

