/-! ### Tools -/

lemma sqrt5_gt : (2236 / 1000 : ℝ) < √5 := (Real.lt_sqrt (by norm_num)).2 (by norm_num)

lemma sqrt5_lt : √5 < (2237 / 1000 : ℝ) := (Real.sqrt_lt' (by norm_num)).2 (by norm_num)

/-- Signs of numbers a + b√5 from 2.236 < √5 < 2.237. -/
macro "s5pos" : tactic => `(tactic| (have h1 := sqrt5_gt; have h3 := sqrt5_lt; linarith))

macro "s5nn" : tactic => `(tactic| (have h1 := sqrt5_gt; have h3 := sqrt5_lt; linarith))

macro "s5ne" : tactic => `(tactic| (have h1 := sqrt5_gt; have h3 := sqrt5_lt; intro h; linarith))

section farkas

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- **Two faces with no common point.** If `a nᵢ + a' nⱼ = μ₁ n_c₁ + μ₂ n_c₂ + μ₃ n_c₃` with `μ ≥ 0` and
`μ₁ b_c₁ + μ₂ b_c₂ + μ₃ b_c₃ < a bᵢ + a' bⱼ`, no point of the solid lies on both faces `i` and `j`. -/
lemma false_of_comb {ι : Type} {n : ι → E} {b : ι → ℝ} {i j c₁ c₂ c₃ : ι} {a a' μ₁ μ₂ μ₃ : ℝ}
    (h₁ : 0 ≤ μ₁) (h₂ : 0 ≤ μ₂) (h₃ : 0 ≤ μ₃)
    (hrel : a • n i + a' • n j = μ₁ • n c₁ + μ₂ • n c₂ + μ₃ • n c₃)
    (hb : μ₁ * b c₁ + μ₂ * b c₂ + μ₃ * b c₃ < a * b i + a' * b j)
    {x : E} (hx : x ∈ sol n b) (hi : ⟪n i, x⟫ = b i) (hj : ⟪n j, x⟫ = b j) : False := by
  have h := congrArg (fun w => ⟪w, x⟫) hrel
  simp only [inner_add_left, real_inner_smul_left] at h
  rw [hi, hj] at h
  have e1 : μ₁ * ⟪n c₁, x⟫ ≤ μ₁ * b c₁ := mul_le_mul_of_nonneg_left (hx c₁) h₁
  have e2 : μ₂ * ⟪n c₂, x⟫ ≤ μ₂ * b c₂ := mul_le_mul_of_nonneg_left (hx c₂) h₂
  have e3 : μ₃ * ⟪n c₃, x⟫ ≤ μ₃ * b c₃ := mul_le_mul_of_nonneg_left (hx c₃) h₃
  linarith

end farkas

