    (hj : ⟪dodN 11, x⟫ = dodB 11) : dodCover x 10 11 :=
  (false_of_comb (i := 10) (j := 11) (c₁ := 6) (c₂ := 7) (c₃ := 10) (a := 1) (a' := 1)
    (μ₁ := (-(1 / 2) + (1 / 2) * √5)) (μ₂ := (-(1 / 2) + (1 / 2) * √5)) (μ₃ := 0) (by s5nn) (by s5nn) (by s5nn)
    (by have ht := sqrt5_sq; ext t; fin_cases t <;> simp [dodN] <;> grind)
    (by
      have ht := sqrt5_sq
      have e : 1 * dodB 10 + 1 * dodB 11 - ((-(1 / 2) + (1 / 2) * √5) * dodB 6 + (-(1 / 2) + (1 / 2) * √5) * dodB 7 +
          0 * dodB 10) = 8 := by simp [dodB]; grind
      have h1 := sqrt5_gt; have h2 := sqrt5_lt
      linarith)
    hx hi hj).elim

