{
  "name": "kaleidohedra",
  "private": true,
  "description": "Kaleidohedra and Rhombiverse by DICTO: one app with two front doors (KRP). devDependencies has esbuild, used ONLY by scripts/build.mjs at Vercel build time (SITE=kaleidohedra|rhombiverse picks the front door) to minify src/**/*.js -- local dev stays plain ES modules with no build step.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:targets": "node scripts/verify-targets.mjs",
    "verify:copy": "node scripts/verify-copy.mjs",
    "verify:about": "node scripts/verify-about.mjs",
    "verify:rhombis-i18n": "node scripts/verify-rhombis-i18n.mjs",
    "verify:lattice-2d": "node scripts/verify-lattice-2d.mjs",
    "verify:dicto-hex": "node scripts/verify-dicto-hex.mjs",
    "verify:4d": "node scripts/verify-4d.mjs",
    "verify:catalogue": "node scripts/verify-catalogue.mjs",
    "verify:kaleidoscope": "node scripts/verify-kaleidoscope.mjs",
    "verify:trajectory": "node scripts/verify-trajectory.mjs",
    "verify:construction": "node scripts/verify-construction.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
