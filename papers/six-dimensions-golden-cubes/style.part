<style>table{border-collapse:collapse;font-size:7.6pt;margin:3mm 0;width:100%} td,th{border-bottom:1px solid #ddd;padding:0.7mm 1.2mm;text-align:left;vertical-align:top}
td.n,th.n{text-align:right} p.prec{font-size:9pt;color:#3a3a3a;border-left:2px solid #b8962e;padding-left:3mm;margin:3mm 0} .thm{border-left:3px solid #b8962e;padding-left:3mm;margin:3mm 0}
p.hook{font-style:italic;color:#4a3f2a;border-left:2px solid #c9a24a;padding-left:3mm} figure{margin:3mm 0;break-inside:avoid} figure img{width:100%;display:block} figcaption{font-size:8.2pt;color:#333;margin-top:1.5mm}
.sw{display:inline-block;width:2.4mm;height:2.4mm;border:0.6px solid #222;margin:0 0.8mm 0 1.2mm;vertical-align:-0.3mm} .plates{break-before:page} figure.pl{margin:0 0 5mm}
ul.src li{font-size:8.6pt} .draft{color:#a00;font-weight:600} .status{border:2px solid #a00;border-radius:2mm;padding:2mm 3mm;margin:3mm 0;font-size:9pt;color:#300;background:#fff6f6} .status ul{margin:1mm 0 0 4mm;padding:0} h2,h3{break-after:avoid} table{break-inside:avoid} table.big{break-inside:auto} table.big tr{break-inside:avoid} table.big th:last-child{width:27%} thead{display:table-header-group}</style>
